pragma solidity ^0.8.13;

/// Fixture for tests/live `revert_explained`: a keeper whose call fails two
/// frames down, in a token with a custom error.
contract MiniToken {
    error InsufficientBalance(address sender, uint256 balance, uint256 needed);

    mapping(address => uint256) public balanceOf;

    function mint(address to, uint256 amount) external {
        balanceOf[to] += amount;
    }

    function transfer(address to, uint256 amount) external returns (bool) {
        uint256 balance = balanceOf[msg.sender];
        if (balance < amount) revert InsufficientBalance(msg.sender, balance, amount);
        balanceOf[msg.sender] = balance - amount;
        balanceOf[to] += amount;
        return true;
    }
}

contract Keeper {
    MiniToken public immutable token;

    constructor(MiniToken _token) {
        token = _token;
    }

    /// Pays `amount` to `to` from the keeper's own balance.
    function payout(address to, uint256 amount) external {
        require(token.transfer(to, amount), "transfer failed");
    }
}

/// Runtime code over the 24,576-byte limit (EIP-170), to check the message.
contract Oversized {
    function blob() external pure returns (bytes memory) {
        return hex"";
    }
}
