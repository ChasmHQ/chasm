// Transaction and call step debugger for the workspace node. Layout follows
// disassembler tools: source and opcode listings side by side, machine state
// on the right, the step timeline along the bottom.
import { LineEdit } from "std-widgets.slint";
import { ListView, ScrollView, TextEdit } from "scroll.slint";
import { ActionControl, DockTab, IconButton, SideHeader, Theme } from "theme.slint";
import { SelectableText } from "selectable-text.slint";

export struct TraceLine { number: int, text: string, current: bool, breakpoint: bool, hits: int }
export struct TraceOp { index: int, pc: string, op: string, gas: string, depth: int, current: bool }
export struct TraceValue { label: string, value: string, changed: bool }
export struct TraceTarget { label: string, detail: string, query: string }

export global TraceData {
    in property <bool> loaded;
    in property <bool> busy;
    in property <string> status;
    in property <string> title;
    in property <string> summary;
    in property <string> location;
    in property <int> cursor;
    in property <int> total;
    in property <string> file;
    in property <[TraceLine]> source;
    in property <int> source-current: -1;
    in property <[TraceOp]> ops;
    in property <int> ops-current: -1;
    in property <[TraceValue]> stack;
    in property <[TraceValue]> memory;
    in property <[TraceValue]> storage;
    in property <[TraceValue]> frames;
    // Call arguments and named storage writes.
    in property <[TraceValue]> variables;
    in property <[TraceValue]> step-info;
    in property <[TraceTarget]> targets;
    // Recordings saved under .chasm/traces; `query` is the file name.
    in property <[TraceTarget]> saved;
    in property <string> saved-folder;
    in-out property <string> input;
    in-out property <string> opcode-filter: "SSTORE";
    in-out property <int> state-tab: 0;
    // Pane sizes in logical px and the compact density switch. Kept here so
    // they survive reloading the session.
    in-out property <float> opcodes-width: 260;
    in-out property <float> state-width: 380;
    in-out property <float> console-height: 150;
    in-out property <bool> show-opcodes: true;
    in-out property <bool> show-state: true;
    in-out property <bool> show-console: true;
    in-out property <bool> compact;
    // Console transcript and prompt.
    in property <string> console-text;
    in property <bool> can-refork;
    in property <[string]> console-lines;
    in-out property <string> console-input;
}

export global TraceLogic {
    callback load(string);
    callback load-recent(int);
    callback navigate(string);
    callback seek(int);
    callback toggle-breakpoint(int);
    callback next-opcode(string, bool);
    callback clear();
    callback open-saved(string);
    callback reveal-saved(string);
    callback delete-saved(string);
    callback console-run(string);
    // Re-fork at the block named in the status, then debug the same hash.
    callback refork();
    callback console-history(int);
}

// Drag handle between two trace panes. `extent` is the size of the pane on
// the `grows` side (left or above); dragging updates it through `resized`.
component PaneSplitter inherits Rectangle {
    in property <bool> horizontal;
    in property <float> extent;
    in property <float> minimum: 120;
    in property <float> maximum: 900;
    // +1 when dragging right/down grows the pane, -1 when it shrinks it.
    in property <int> sign: 1;
    callback resized(float);
    private property <float> initial;
    private property <length> origin;
    min-width: root.horizontal ? 0px : 5px;
    max-width: root.horizontal ? 100000px : 5px;
    min-height: root.horizontal ? 5px : 0px;
    max-height: root.horizontal ? 5px : 100000px;
    horizontal-stretch: 0; vertical-stretch: 0;
    background: keyboard.has-focus ? Theme.accent : touch.has-hover || touch.pressed ? Theme.edge : Theme.line;
    accessible-role: slider;
    accessible-label: "Resize debugger pane";
    accessible-value: root.extent;
    forward-focus: keyboard;
    touch := TouchArea {
        mouse-cursor: root.horizontal ? ns-resize : ew-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.initial = root.extent;
                root.origin = root.horizontal ? self.absolute-position.y + self.mouse-y : self.absolute-position.x + self.mouse-x;
            }
        }
        moved => {
            if self.pressed {
                let delta = (root.horizontal ? self.absolute-position.y + self.mouse-y : self.absolute-position.x + self.mouse-x) - root.origin;
                root.resized(max(root.minimum, min(root.maximum, root.initial + root.sign * delta / (1px * Theme.zoom))));
            }
        }
    }
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.resized(max(root.minimum, min(root.maximum, root.extent - 20 * root.sign))); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.resized(max(root.minimum, min(root.maximum, root.extent + 20 * root.sign))); return accept; }
            return reject;
        }
    }
}

component ToolButton inherits ActionControl {
    in property <string> text;
    in property <string> key;
    // What the button does, shown in the summary row while hovered.
    in property <string> tip;
    callback hover-tip(string);
    changed hovered => { root.hover-tip(self.hovered ? root.tip : ""); }
    label: root.text;
    height: Theme.control-height;
    min-width: content.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    content := HorizontalLayout {
        padding-left: 0.5rem; padding-right: 0.5rem; spacing: 0.25rem;
        Text { text: root.text; color: root.enabled ? Theme.text : Theme.faint; font-size: 0.8125rem; vertical-alignment: center; }
        if root.key != "": Text { text: root.key; color: Theme.faint; font-size: 0.6875rem; vertical-alignment: center; }
    }
}

component StateRow inherits Rectangle {
    in property <TraceValue> item;
    height: max(1.5rem, row-layout.preferred-height + 0.25rem);
    background: root.item.changed ? #d7ba7d22 : transparent;
    row-layout := HorizontalLayout {
        padding-left: 0.5rem; padding-right: 0.75rem; padding-top: 0.125rem; spacing: 0.5rem;
        Text { text: root.item.label; width: 4.5rem; color: Theme.muted; font-family: "Cascadia Mono"; font-size: 0.6875rem; vertical-alignment: top; overflow: elide; }
        SelectableText { text: root.item.value; color: root.item.changed ? Theme.accent : Theme.text; font-family: "Cascadia Mono"; font-size: 0.6875rem; wrap: word-wrap; min-width: 0px; horizontal-stretch: 1; }
    }
}

// Name above value, for long names such as mapping keys.
component StackedRow inherits Rectangle {
    in property <TraceValue> item;
    height: max(1.5rem, row-layout.preferred-height);
    background: root.item.changed ? #d7ba7d22 : transparent;
    row-layout := VerticalLayout {
        padding-left: 0.5rem; padding-right: 0.75rem; padding-top: 0.25rem; padding-bottom: 0.25rem;
        SelectableText { text: root.item.label; color: Theme.muted; font-family: "Cascadia Mono"; font-size: 0.6875rem; wrap: word-wrap; }
        SelectableText { text: root.item.value; color: root.item.changed ? Theme.accent : Theme.text; font-family: "Cascadia Mono"; font-size: 0.6875rem; wrap: word-wrap; }
    }
}

component StateList inherits Rectangle {
    in property <[TraceValue]> items;
    in property <string> empty;
    in property <bool> stacked;
    background: Theme.inset;
    if root.items.length == 0: Text { x: Theme.pad; y: Theme.pad; text: root.empty; color: Theme.faint; font-size: 0.75rem; width: parent.width - 2 * Theme.pad; wrap: word-wrap; }
    if !root.stacked: ListView {
        for item in root.items: StateRow { item: item; }
    }
    if root.stacked: ListView {
        for item in root.items: StackedRow { item: item; }
    }
}

export component TraceDebugger inherits Rectangle {
    private property <string> tip;
    private property <length> step-row: TraceData.compact ? 1.125rem : 1.375rem;
    private property <length> mono: TraceData.compact ? 0.6875rem : 0.75rem;
    background: Theme.canvas;
    min-width: 0px; min-height: 0px;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if !TraceData.loaded { return reject; }
            // Ctrl reverses any step key.
            if event.text == Key.F5 && !event.modifiers.shift { TraceLogic.navigate("continue"); return accept; }
            if event.text == Key.F5 && event.modifiers.shift { TraceLogic.navigate("back"); return accept; }
            if event.text == Key.F10 && (event.modifiers.control || event.modifiers.shift) { TraceLogic.navigate("prev-next"); return accept; }
            if event.text == Key.F10 { TraceLogic.navigate("next"); return accept; }
            if event.text == Key.F11 && event.modifiers.control && event.modifiers.shift { TraceLogic.navigate("finish-back"); return accept; }
            if event.text == Key.F11 && event.modifiers.control { TraceLogic.navigate("step-back"); return accept; }
            if event.text == Key.F11 && event.modifiers.shift { TraceLogic.navigate("finish"); return accept; }
            if event.text == Key.F11 { TraceLogic.navigate("step"); return accept; }
            if event.text == Key.F7 { TraceLogic.navigate("op"); return accept; }
            if event.text == Key.F8 { TraceLogic.navigate("op-back"); return accept; }
            if event.text == Key.Home { TraceLogic.seek(0); return accept; }
            if event.text == Key.End { TraceLogic.seek(TraceData.total - 1); return accept; }
            return reject;
        }
        VerticalLayout {
            // Target bar: what to debug.
            Rectangle {
                height: target-row.preferred-height;
                background: Theme.panel;
                target-row := HorizontalLayout {
                    padding: 0.375rem; padding-left: Theme.pad; spacing: 0.375rem;
                    Text { text: "Debug"; color: Theme.muted; font-size: 0.8125rem; vertical-alignment: center; horizontal-stretch: 0; }
                    LineEdit {
                        horizontal-stretch: 1; min-width: 0px;
                        font-size: 0.8125rem;
                        placeholder-text: "Transaction hash, or leave empty to debug the last transaction or call";
                        text <=> TraceData.input;
                        accepted => { TraceLogic.load(self.text); }
                    }
                    IconButton { icon: @image-url("icons/debugger.svg"); label: TraceData.busy ? "Tracing…" : "Debug"; primary: true; enabled: !TraceData.busy; clicked => { TraceLogic.load(TraceData.input); } }
                    if TraceData.loaded: IconButton { icon: @image-url("icons/stop.svg"); label: "Close session"; clicked => { TraceLogic.clear(); } }
                }
            }
            if !TraceData.loaded: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: Theme.pad * 2; spacing: 0.5rem; alignment: start;
                    SelectableText { text: TraceData.busy ? "Recording the execution…" : TraceData.status != "" ? TraceData.status : "Nothing loaded"; font-size: 1rem; font-weight: 600; wrap: word-wrap; }
                    if TraceData.can-refork: HorizontalLayout {
                        alignment: start;
                        IconButton { icon: @image-url("icons/refresh.svg"); label: "Re-fork there and debug"; primary: true; clicked => { TraceLogic.refork(); } }
                    }
                    SelectableText { text: "Pick a recent transaction below, paste a hash above, or use Debug in a contract's Response pane after a Send or Simulate. Every opcode is recorded once, so you can step forwards and backwards freely."; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; }
                    if TraceData.saved.length > 0: SideHeader { title: "Saved traces"; trailing: "reopen without the node"; }
                    if TraceData.saved.length > 0: SelectableText { text: TraceData.saved-folder; color: Theme.faint; font-family: "Cascadia Mono"; font-size: 0.6875rem; wrap: word-wrap; }
                    for item in TraceData.saved: HorizontalLayout {
                        spacing: 0.25rem;
                        ActionControl {
                            label: "Open saved trace \{item.label}";
                            height: 2.5rem; horizontal-stretch: 1;
                            clicked => { TraceLogic.open-saved(item.query); }
                            VerticalLayout {
                                padding-left: Theme.pad; alignment: center;
                                Text { text: item.label; color: Theme.text; font-family: "Cascadia Mono"; font-size: 0.75rem; overflow: elide; }
                                Text { text: item.detail; color: Theme.muted; font-size: 0.6875rem; overflow: elide; }
                            }
                        }
                        ToolButton { text: "Show in folder"; clicked => { TraceLogic.reveal-saved(item.query); } }
                        ToolButton { text: "Delete"; clicked => { TraceLogic.delete-saved(item.query); } }
                    }
                    SideHeader { title: "Recent transactions on this node"; }
                    if TraceData.targets.length == 0: SelectableText { text: "No transactions yet. Deploy or send something first."; color: Theme.faint; font-size: 0.75rem; }
                    for target[index] in TraceData.targets: ActionControl {
                        label: target.label;
                        height: 2.5rem;
                        clicked => { TraceLogic.load-recent(index); }
                        VerticalLayout {
                            padding-left: Theme.pad; alignment: center;
                            Text { text: target.label; color: Theme.text; font-family: "Cascadia Mono"; font-size: 0.75rem; overflow: elide; }
                            Text { text: target.detail; color: Theme.muted; font-size: 0.6875rem; overflow: elide; }
                        }
                    }
                }
            }
            if TraceData.loaded: VerticalLayout {
                vertical-stretch: 1;
                // Session toolbar.
                Rectangle {
                    height: Theme.control-height + 0.5rem;
                    background: Theme.bar;
                    ScrollView {
                    vertical-scrollbar-policy: always-off;
                    content-width: max(self.visible-width, tools.preferred-width);
                    content-height: self.visible-height;
                    tools := HorizontalLayout {
                        padding-left: 0.375rem; padding-right: Theme.pad; spacing: 0.125rem;
                        ToolButton { text: "Back"; key: "Shift+F5"; tip: "Run backwards to the previous breakpoint, or the start."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("back"); } }
                        ToolButton { text: "Continue"; key: "F5"; tip: "Run to the next breakpoint, or the end."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("continue"); } }
                        Rectangle { width: 1px; background: Theme.line; }
                        ToolButton { text: "Step into"; key: "F11"; tip: "Next source line, entering any call or internal function it makes."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("step"); } }
                        ToolButton { text: "Step over"; key: "F10"; tip: "Next line in this function. Calls and internal functions on this line run to completion."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("next"); } }
                        ToolButton { text: "Step out"; key: "Shift+F11"; tip: "Run until this function returns, then stop in its caller."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("finish"); } }
                        ToolButton { text: "Step instruction"; key: "F7"; tip: "Exactly one EVM instruction forward (sevm stepi)."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("op"); } }
                        Rectangle { width: 1px; background: Theme.line; }
                        Text { text: "Reverse"; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; }
                        ToolButton { text: "Into"; key: "Ctrl+F11"; tip: "Reverse step into: the previous source line, wherever it ran."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("step-back"); } }
                        ToolButton { text: "Over"; key: "Ctrl+F10"; tip: "Reverse step over: the previous line in this function, skipping calls."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("prev-next"); } }
                        ToolButton { text: "Out"; key: "Ctrl+Shift+F11"; tip: "Reverse step out: back to the step that called this function."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("finish-back"); } }
                        ToolButton { text: "Instruction"; key: "F8"; tip: "Exactly one EVM instruction back."; hover-tip(text) => { root.tip = text; } clicked => { TraceLogic.navigate("op-back"); } }
                    }
                    }
                }
                Rectangle {
                    height: max(summary-row.preferred-height, Theme.control-height + 0.25rem);
                    background: Theme.panel;
                    summary-row := HorizontalLayout {
                        padding-left: Theme.pad; padding-right: 0.375rem; spacing: 1rem;
                        Text { text: TraceData.title; font-weight: 600; font-size: 0.8125rem; color: Theme.text; horizontal-stretch: 0; min-width: 0px; max-width: 16rem; overflow: elide; vertical-alignment: center; }
                        Text { text: TraceData.location; color: Theme.accent; font-family: "Cascadia Mono"; font-size: 0.75rem; horizontal-stretch: 0; min-width: 0px; max-width: 22rem; overflow: elide; vertical-alignment: center; }
                        SelectableText { text: root.tip != "" ? root.tip : TraceData.summary; color: root.tip != "" ? Theme.text : Theme.muted; font-size: 0.75rem; horizontal-stretch: 1; min-width: 0px; wrap: no-wrap; overflow: elide; vertical-alignment: center; }
                        HorizontalLayout {
                            horizontal-stretch: 0; spacing: 0.125rem;
                            Rectangle { width: 1px; background: Theme.line; }
                            Text { text: "Find"; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; }
                            LineEdit { width: 5.5rem; font-size: 0.75rem; text <=> TraceData.opcode-filter; accepted => { TraceLogic.next-opcode(self.text, true); } }
                            ToolButton { text: "Prev"; clicked => { TraceLogic.next-opcode(TraceData.opcode-filter, false); } }
                            ToolButton { text: "Next"; clicked => { TraceLogic.next-opcode(TraceData.opcode-filter, true); } }
                            Rectangle { width: 1px; background: Theme.line; }
                            Text { text: "Panes"; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; }
                            DockTab { label: "Ops"; min-width: self.preferred-width; selected: TraceData.show-opcodes; clicked => { TraceData.show-opcodes = !TraceData.show-opcodes; } }
                            DockTab { label: "State"; min-width: self.preferred-width; selected: TraceData.show-state; clicked => { TraceData.show-state = !TraceData.show-state; } }
                            DockTab { label: "Console"; min-width: self.preferred-width; selected: TraceData.show-console; clicked => { TraceData.show-console = !TraceData.show-console; } }
                            DockTab { label: "Compact"; min-width: self.preferred-width; selected: TraceData.compact; clicked => { TraceData.compact = !TraceData.compact; } }
                            Text { text: "Step \{TraceData.cursor + 1} of \{TraceData.total}"; color: Theme.muted; font-family: "Cascadia Mono"; font-size: 0.75rem; vertical-alignment: center; }
                        }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;
                    // Source listing.
                    Rectangle {
                        horizontal-stretch: 5; min-width: 0px;
                        background: Theme.inset;
                        VerticalLayout {
                            SideHeader { title: TraceData.file == "" ? "Source (no matching workspace contract)" : TraceData.file; trailing: "click a line number for a breakpoint"; }
                            source-list := ListView {
                                property <int> current: TraceData.source-current;
                                changed current => {
                                    if self.current >= 0 {
                                        let top = self.current * root.step-row;
                                        if top + self.content-y < 2rem || top + self.content-y > self.visible-height - 3rem {
                                            self.content-y = min(0px, max(self.visible-height - self.content-height, 6rem - top));
                                        }
                                    }
                                }
                                for line in TraceData.source: Rectangle {
                                    height: root.step-row;
                                    background: line.current ? #d7ba7d2e : transparent;
                                    HorizontalLayout {
                                        TouchArea {
                                            width: 3.75rem;
                                            mouse-cursor: pointer;
                                            clicked => { TraceLogic.toggle-breakpoint(line.number); }
                                            HorizontalLayout {
                                                padding-right: 0.5rem; spacing: 0.25rem; alignment: end;
                                                Rectangle {
                                                    width: 0.5rem; height: 0.5rem; y: (parent.height - self.height) / 2;
                                                    border-radius: 0.25rem;
                                                    background: line.breakpoint ? Theme.danger : transparent;
                                                    border-width: line.breakpoint ? 0px : 0px;
                                                }
                                                Text { text: line.number; color: line.current ? Theme.accent : Theme.faint; font-family: "Cascadia Mono"; font-size: root.mono; vertical-alignment: center; }
                                            }
                                        }
                                        Text { text: line.current ? "›" : " "; width: 0.75rem; color: Theme.accent; font-family: "Cascadia Mono"; font-size: root.mono; vertical-alignment: center; }
                                        Text { text: line.text; color: line.hits > 0 ? Theme.text : Theme.muted; font-family: "Cascadia Mono"; font-size: root.mono; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        if line.hits > 0: Text { text: "\{line.hits}×"; color: Theme.faint; font-family: "Cascadia Mono"; font-size: 0.625rem; vertical-alignment: center; width: 2.5rem; horizontal-alignment: right; }
                                    }
                                }
                            }
                        }
                    }
                    if TraceData.show-opcodes: PaneSplitter { extent: TraceData.opcodes-width; sign: -1; minimum: 220; maximum: 700; resized(value) => { TraceData.opcodes-width = value; } }
                    // Opcode listing around the cursor.
                    if TraceData.show-opcodes: Rectangle {
                        horizontal-stretch: 0; width: TraceData.opcodes-width * Theme.unit;
                        background: Theme.inset;
                        VerticalLayout {
                            SideHeader { title: "Executed opcodes"; trailing: "pc  op  gas"; }
                            ListView {
                                property <int> current: TraceData.ops-current;
                                changed current => {
                                    if self.current >= 0 {
                                        let top = self.current * root.step-row;
                                        if top + self.content-y < 2rem || top + self.content-y > self.visible-height - 3rem {
                                            self.content-y = min(0px, max(self.visible-height - self.content-height, self.visible-height / 2 - top));
                                        }
                                    }
                                }
                                init => {
                                    self.content-y = min(0px, max(self.visible-height - self.content-height, self.visible-height / 2 - self.current * root.step-row));
                                }
                                for op in TraceData.ops: ActionControl {
                                    label: "\{op.pc} \{op.op}";
                                    height: root.step-row;
                                    selected: op.current;
                                    transparent-background: !op.current && !self.hovered;
                                    clicked => { TraceLogic.seek(op.index); }
                                    HorizontalLayout {
                                        padding-left: 0.5rem; spacing: 0.5rem;
                                        Text { text: op.depth > 1 ? "\{op.depth}" : " "; width: 1rem; color: Theme.faint; font-family: "Cascadia Mono"; font-size: 0.6875rem; vertical-alignment: center; }
                                        Text { text: op.pc; width: 3.5rem; color: Theme.faint; font-family: "Cascadia Mono"; font-size: root.mono; vertical-alignment: center; }
                                        Text { text: op.op; color: op.current ? Theme.accent : op.op == "SSTORE" || op.op == "SLOAD" ? Theme.warn : op.op == "CALL" || op.op == "DELEGATECALL" || op.op == "STATICCALL" || op.op == "REVERT" ? Theme.danger : Theme.text; font-family: "Cascadia Mono"; font-size: root.mono; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: op.gas; color: Theme.faint; font-family: "Cascadia Mono"; font-size: 0.6875rem; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    if TraceData.show-state: PaneSplitter { extent: TraceData.state-width; sign: -1; minimum: 200; maximum: 900; resized(value) => { TraceData.state-width = value; } }
                    // Machine state.
                    if TraceData.show-state: Rectangle {
                        horizontal-stretch: 0; width: TraceData.state-width * Theme.unit;
                        background: Theme.panel;
                        VerticalLayout {
                            HorizontalLayout {
                                height: Theme.tab-height;
                                DockTab { label: "Stack"; selected: TraceData.state-tab == 0; clicked => { TraceData.state-tab = 0; } }
                                DockTab { label: "Memory"; selected: TraceData.state-tab == 1; clicked => { TraceData.state-tab = 1; } }
                                DockTab { label: "Storage"; selected: TraceData.state-tab == 2; clicked => { TraceData.state-tab = 2; } }
                                DockTab { label: "Calls"; selected: TraceData.state-tab == 3; clicked => { TraceData.state-tab = 3; } }
                                DockTab { label: "Variables"; selected: TraceData.state-tab == 4; clicked => { TraceData.state-tab = 4; } }
                            }
                            if TraceData.state-tab == 0: StateList { items: TraceData.stack; empty: "Stack is empty."; vertical-stretch: 1; }
                            if TraceData.state-tab == 1: StateList { items: TraceData.memory; empty: "No memory used yet."; vertical-stretch: 1; }
                            if TraceData.state-tab == 2: StateList { items: TraceData.storage; empty: "No storage touched yet in this frame."; vertical-stretch: 1; }
                            if TraceData.state-tab == 3: StateList { items: TraceData.frames; empty: "No call frames."; vertical-stretch: 1; }
                            if TraceData.state-tab == 4: StateList { stacked: true; items: TraceData.variables; empty: "No arguments decoded and no storage written. Variables need the contract's ABI and storage layout from this workspace."; vertical-stretch: 1; }
                            SideHeader { title: "This step"; }
                            StateList { items: TraceData.step-info; empty: ""; height: TraceData.compact ? 7rem : 8.5rem; }
                        }
                    }
                }
                if TraceData.show-console: PaneSplitter { horizontal: true; extent: TraceData.console-height; sign: -1; minimum: 70; maximum: 600; resized(value) => { TraceData.console-height = value; } }
                // sevm-style command line over the recorded steps.
                if TraceData.show-console: Rectangle {
                    height: TraceData.console-height * Theme.unit;
                    background: Theme.inset;
                    VerticalLayout {
                        console-log := ListView {
                            vertical-stretch: 1; min-height: 0px;
                            // Follow new output to the last line.
                            property <int> count: TraceData.console-lines.length;
                            changed count => { self.content-y = min(0px, self.visible-height - self.content-height); }
                            changed content-height => { self.content-y = min(0px, self.visible-height - self.content-height); }
                            for item in TraceData.console-lines: SelectableText {
                                height: root.step-row;
                                x: 0.5rem;
                                text: item;
                                wrap: no-wrap;
                                // Echoed commands are dimmed so the output stands out.
                                color: item.starts-with("(trace) ") ? Theme.muted : Theme.text;
                                font-family: "Cascadia Mono";
                                font-size: root.mono;
                                vertical-alignment: center;
                            }
                        }
                        FocusScope {
                            height: Theme.control-height;
                            forward-focus: console-prompt;
                            capture-key-pressed(event) => {
                                if event.text == Key.UpArrow { TraceLogic.console-history(-1); return accept; }
                                if event.text == Key.DownArrow { TraceLogic.console-history(1); return accept; }
                                return reject;
                            }
                            console-prompt := LineEdit {
                                width: parent.width; height: parent.height;
                                font-family: "Cascadia Mono"; font-size: 0.8125rem;
                                placeholder-text: "(trace) s, n, si, fin, c, rc, b 28, p stack[0], x 0x40, sload 0, find SSTORE, help";
                                accessible-label: "Trace console command";
                                text <=> TraceData.console-input;
                                accepted => { TraceLogic.console-run(self.text); }
                            }
                        }
                    }
                }
                // Timeline: click anywhere to jump to that step.
                Rectangle {
                    height: 1.5rem;
                    background: Theme.bar;
                    timeline := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { TraceLogic.seek(Math.round(self.mouse-x / max(1px, self.width) * (TraceData.total - 1))); }
                        moved => { if self.pressed { TraceLogic.seek(Math.round(max(0, min(1, self.mouse-x / max(1px, self.width))) * (TraceData.total - 1))); } }
                    }
                    Rectangle { x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: 2px; background: Theme.line; }
                    Rectangle {
                        x: TraceData.total > 1 ? (parent.width - self.width) * TraceData.cursor / (TraceData.total - 1) : 0px;
                        y: (parent.height - self.height) / 2;
                        width: 0.5rem; height: 1rem; border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }
        }
    }
}
