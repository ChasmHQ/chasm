// Workspace > Compiler and libraries: the solc version and the Solidity
// libraries the project imports.
import { LineEdit } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { ActionControl, DockTab, IconButton, SideHeader, Theme } from "theme.slint";
import { SelectableText } from "selectable-text.slint";

export struct LibraryRow { id: string, title: string, prefix: string, installed: string, used: string, missing: bool }
export struct PragmaRow { file: string, pragma: string }
export struct NetworkProfileRow { id: string, title: string, detail: string, active: bool, builtin: bool }

export global ToolchainData {
    in property <string> locked;
    in property <[string]> installed-solc;
    in property <[PragmaRow]> pragmas;
    in property <[LibraryRow]> libraries;
    in property <string> status;
    in property <bool> busy;
    in property <string> lib-folder;
    in property <int> missing-count;
    in-out property <string> solc-input;
    // Saved profiles and the built-in local chain; the form edits the
    // selected profile (the active one until a row is clicked).
    in property <[NetworkProfileRow]> profiles;
    in property <string> fork-saved;
    in property <string> fork-running;
    // How Switch applies the target: resume its saved state, or discard it
    // first (always confirmed locally).
    in-out property <bool> switch-fresh: false;
    // Non-empty when the forked chain is not Ethereum or Sepolia.
    in property <string> chain-warning;
    in property <string> fresh-target;
    in-out property <string> selected-profile;
    in-out property <string> profile-name;
    // 0 = chain id Local (31337), 1 = the forked chain's own id.
    in-out property <int> chain-mode: 0;
    in-out property <string> fork-url;
    in-out property <string> fork-block;
    // Names of the public RPCs; picking one fills the URL.
    in property <[string]> presets;
    in-out property <string> tag-input;
    // [compiler] settings: the summary and the form.
    in property <string> settings-summary;
    // [build] source: auto, foundry or chasm; what Auto resolved to; errors.
    in property <string> build-chosen;
    in property <string> build-active;
    in property <string> build-origin;
    in property <string> build-error;
    // Foundry projects whose built artifacts the debugger maps without recompiling.
    in property <[string]> imports;
    in-out property <string> import-input;
    in-out property <int> optimizer: 0;
    in-out property <string> optimizer-runs;
    in-out property <bool> via-ir;
    in-out property <string> evm-version;
    in-out property <string> bytecode-hash;
}

export global ToolchainLogic {
    callback lock-solc(string);
    callback install(string, string);
    callback use-version(string, string);
    callback remove(string);
    // The legacy alias that edits the active profile's URL and block.
    callback save-network(string, string);
    callback profile-select(string);
    callback profile-add(string);
    callback profile-duplicate(string);
    callback profile-remove(string);
    // id, name, url, block, chain id mode ("local" or "source").
    callback profile-save(string, string, string, string, string);
    // id, fresh (discard the profile's saved state; needs local approval).
    callback profile-switch(string, bool);
    callback confirm-fresh(string);
    callback cancel-fresh();
    callback preset(int);
    // optimizer: 0 default, 1 on, 2 off.
    callback save-settings(int, string, bool, string, string);
    callback build-source(string);
    callback test-rpc(string, string);
    callback add-import(string);
    callback remove-import(string);
}

component Small inherits ActionControl {
    in property <string> text;
    label: root.text;
    height: Theme.control-height;
    min-width: content.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    content := HorizontalLayout {
        padding-left: 0.5rem; padding-right: 0.5rem;
        Text { text: root.text; color: root.enabled ? Theme.text : Theme.faint; font-size: 0.75rem; vertical-alignment: center; }
    }
}

export component ToolchainWorkspace inherits ScrollView {
    min-width: 0px; min-height: 0px;
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    VerticalLayout {
        padding: Theme.pad; spacing: 0.5rem; alignment: start;
        if ToolchainData.status != "": SelectableText { text: ToolchainData.status; color: Theme.accent; font-size: 0.8125rem; wrap: word-wrap; }

        if ToolchainData.missing-count > 0: Rectangle {
            height: missing-text.preferred-height + 1rem;
            background: #e0af6822;
            border-radius: Theme.radius;
            missing-text := SelectableText {
                x: Theme.pad; width: parent.width - 2 * Theme.pad;
                text: "This project imports \{ToolchainData.missing-count} library(ies) that are not mapped, so it cannot compile. They are listed first under Libraries: Install, then Use.";
                color: Theme.warn; font-size: 0.8125rem; wrap: word-wrap;
            }
        }
        SelectableText { text: "Network"; font-weight: 600; font-size: 0.9375rem; }
        if ToolchainData.chain-warning != "": SelectableText { text: ToolchainData.chain-warning; color: Theme.warn; font-size: 0.8125rem; wrap: word-wrap; }
        SelectableText { text: "The project node is \{ToolchainData.fork-running}. Fork a live chain to call and debug real contracts locally: the node copies state on demand from the RPC and, in chain id Local, keeps id 31337 so nothing is ever valid on the real network."; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 0.25rem;
            Text { text: "Switch"; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
            DockTab { label: "Resume saved state"; selected: !ToolchainData.switch-fresh; horizontal-stretch: 0; clicked => { ToolchainLogic.cancel-fresh(); ToolchainData.switch-fresh = false; } }
            DockTab { label: "Clean fork"; selected: ToolchainData.switch-fresh; horizontal-stretch: 0; clicked => { ToolchainData.switch-fresh = true; } }
            Rectangle { horizontal-stretch: 1; }
        }
        SelectableText { text: "Each network keeps its own state in .chasm/networks/<id>: the node's dump, deployments, bound tabs and the signer choice (never keys; a keystore must be unlocked again). Switching away saves the network that runs now; Switch restores the target's, and a rejected target leaves the current network running."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
        if ToolchainData.fresh-target != "": VerticalLayout {
            spacing: 0.25rem;
            SelectableText { text: "Start \{ToolchainData.fresh-target} clean? Its saved chain, deployments, bound tabs and signer choice will be moved aside under .chasm/networks/."; color: Theme.warn; font-size: 0.8125rem; wrap: word-wrap; }
            HorizontalLayout {
                alignment: start; spacing: 0.375rem;
                Small { text: "Cancel"; clicked => { ToolchainLogic.cancel-fresh(); } }
                Small { text: "Confirm clean fork"; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.confirm-fresh(ToolchainData.fresh-target); } }
            }
        }
        for row in ToolchainData.profiles: Rectangle {
            height: network-row.preferred-height + 0.75rem;
            background: row.active ? Theme.panel : transparent;
            border-radius: Theme.radius;
            network-row := HorizontalLayout {
                padding: 0.375rem; padding-left: Theme.pad; spacing: 0.5rem;
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 0.125rem;
                    HorizontalLayout {
                        spacing: 0.5rem;
                        Text { text: row.title; color: Theme.text; font-size: 0.8125rem; font-weight: 600; horizontal-stretch: 0; }
                        if row.active: Text { text: "active"; color: Theme.accent; font-size: 0.6875rem; vertical-alignment: center; }
                    }
                    Text { text: row.detail; color: Theme.muted; font-size: 0.75rem; overflow: elide; }
                }
                Small { text: "Edit"; enabled: !ToolchainData.busy && !row.builtin; clicked => { ToolchainLogic.cancel-fresh(); ToolchainLogic.profile-select(row.id); } }
                Small { text: "Duplicate"; enabled: !ToolchainData.busy && !row.builtin; clicked => { ToolchainLogic.cancel-fresh(); ToolchainLogic.profile-duplicate(row.id); } }
                Small { text: "Delete"; enabled: !ToolchainData.busy && !row.builtin; clicked => { ToolchainLogic.cancel-fresh(); ToolchainLogic.profile-remove(row.id); } }
                Small { text: ToolchainData.switch-fresh ? "Clean fork…" : "Switch"; enabled: !ToolchainData.busy && (!row.active || ToolchainData.switch-fresh); clicked => { ToolchainLogic.profile-switch(row.id, ToolchainData.switch-fresh); } }
            }
        }
        HorizontalLayout {
            spacing: 0.375rem;
            LineEdit { text <=> ToolchainData.profile-name; placeholder-text: "name for a new profile, e.g. Ethereum mainnet"; font-size: 0.8125rem; horizontal-stretch: 1; }
            Small { text: "New profile"; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.cancel-fresh(); ToolchainLogic.profile-add(ToolchainData.profile-name); } }
        }
        HorizontalLayout {
            spacing: 0.25rem;
            Text { text: "Public RPC"; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
            for name[index] in ToolchainData.presets: Small { text: name; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.preset(index); } }
            Small { text: "Local"; enabled: !ToolchainData.busy; clicked => { ToolchainData.fork-url = ""; ToolchainData.fork-block = ""; ToolchainData.chain-mode = 0; } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 0.375rem;
            LineEdit { text <=> ToolchainData.fork-url; placeholder-text: "https://… RPC to fork, empty for a local chain"; font-size: 0.8125rem; min-width: 0px; horizontal-stretch: 3; }
            LineEdit { text <=> ToolchainData.fork-block; placeholder-text: "block (latest)"; font-size: 0.8125rem; min-width: 0px; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 0.375rem;
            DockTab { label: "Chain id Local (31337)"; selected: ToolchainData.chain-mode == 0; clicked => { ToolchainData.chain-mode = 0; } }
            DockTab { label: "Chain id Source"; selected: ToolchainData.chain-mode == 1; clicked => { ToolchainData.chain-mode = 1; } }
            Rectangle { horizontal-stretch: 1; }
        }
        if ToolchainData.chain-mode == 1: SelectableText {
            text: "Chain id Source runs the node with the forked chain's own id, so EIP-712 domains and block.chainid behave as on the real chain. Signatures made here could be replayed there, so personal keystores are blocked: only Anvil dev keys and Act as an address may send.";
            color: Theme.warn; font-size: 0.75rem; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 0.375rem;
            IconButton { icon: @image-url("icons/search.svg"); label: "Test RPC"; enabled: !ToolchainData.busy && ToolchainData.fork-url != ""; clicked => { ToolchainLogic.test-rpc(ToolchainData.fork-url, ToolchainData.fork-block); } }
            IconButton { icon: @image-url("icons/refresh.svg"); label: "Save profile"; primary: true; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.profile-save(ToolchainData.selected-profile, ToolchainData.profile-name, ToolchainData.fork-url, ToolchainData.fork-block, ToolchainData.chain-mode == 1 ? "source" : "local"); } }
        }
        if ToolchainData.fork-saved != ToolchainData.fork-running: SelectableText { text: "Saved setting: \{ToolchainData.fork-saved}. It applies when the project reopens."; color: Theme.warn; font-size: 0.75rem; wrap: word-wrap; }
        SelectableText { text: "Public RPCs rate-limit heavy use; a provider URL with a key belongs in a fork_url_env variable (set fork_url in the form to store it here instead). Reopening resets the local chain; deployments and signer are restored per network in a later phase."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
        Rectangle { height: 1px; background: Theme.line; }

        SelectableText { text: "Build source"; font-weight: 600; font-size: 0.9375rem; }
        SelectableText { text: "Where remappings and compiler settings come from. Auto uses foundry.toml when the folder has one. The two are never mixed."; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 0.25rem; alignment: start;
            DockTab { label: "Auto"; selected: ToolchainData.build-chosen == "auto"; clicked => { ToolchainLogic.build-source("auto"); } }
            DockTab { label: "Foundry (foundry.toml)"; selected: ToolchainData.build-chosen == "foundry"; clicked => { ToolchainLogic.build-source("foundry"); } }
            DockTab { label: "Chasm (.chasm/chasm.toml)"; selected: ToolchainData.build-chosen == "chasm"; clicked => { ToolchainLogic.build-source("chasm"); } }
        }
        if ToolchainData.build-error == "": SelectableText { text: "Active: \{ToolchainData.build-origin}."; color: Theme.accent; font-size: 0.8125rem; wrap: word-wrap; }
        if ToolchainData.build-error != "": SelectableText { text: ToolchainData.build-error; color: Theme.danger; font-size: 0.8125rem; wrap: word-wrap; }
        if ToolchainData.build-active == "foundry": SelectableText { text: "Foundry is active: the settings, solc lock and Use buttons below edit .chasm/chasm.toml and apply only with Build source Chasm."; color: Theme.warn; font-size: 0.75rem; wrap: word-wrap; }
        Rectangle { height: 1px; background: Theme.line; }

        SelectableText { text: "Foundry builds for the debugger"; font-weight: 600; font-size: 0.9375rem; }
        SelectableText { text: "Contracts built by forge in another folder step by source without recompiling: Chasm reads that project's out/ artifacts each time a trace opens. Run forge build there after changes."; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; }
        for folder in ToolchainData.imports: HorizontalLayout {
            spacing: 0.5rem;
            SelectableText { text: folder; font-size: 0.8125rem; horizontal-stretch: 1; vertical-alignment: center; }
            Small { text: "Remove"; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.remove-import(folder); } }
        }
        HorizontalLayout {
            spacing: 0.5rem;
            LineEdit { text <=> ToolchainData.import-input; placeholder-text: "Folder with foundry.toml, e.g. C:/code/protocol"; font-size: 0.8125rem; min-width: 0px; horizontal-stretch: 1; accepted => { ToolchainLogic.add-import(self.text); } }
            Small { text: "Add Foundry build"; enabled: !ToolchainData.busy && ToolchainData.import-input != ""; clicked => { ToolchainLogic.add-import(ToolchainData.import-input); } }
        }
        Rectangle { height: 1px; background: Theme.line; }

        SelectableText { text: "Solidity compiler"; font-weight: 600; font-size: 0.9375rem; }
        SelectableText {
            text: ToolchainData.locked == ""
                ? "Auto: each file is compiled with the newest installed solc its pragma allows; a missing version is downloaded."
                : "Locked to solc \{ToolchainData.locked} for every file (saved in .chasm/chasm.toml). Files whose pragma excludes it fail to compile.";
            color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 0.375rem;
            LineEdit { text <=> ToolchainData.solc-input; placeholder-text: "0.8.24, or empty for Auto"; font-size: 0.8125rem; min-width: 0px; horizontal-stretch: 1; accepted => { ToolchainLogic.lock-solc(self.text); } }
            IconButton { icon: @image-url("icons/refresh.svg"); label: ToolchainData.solc-input == "" ? "Use Auto" : "Lock and recompile"; primary: true; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.lock-solc(ToolchainData.solc-input); } }
        }
        SelectableText { text: "Settings: \{ToolchainData.settings-summary}. Deployed code only shows its source when these match how it was built (see foundry.toml)."; color: Theme.muted; font-size: 0.75rem; wrap: word-wrap; }
        FlexboxLayout {
            spacing: 0.375rem;
            DockTab { label: "Optimizer default"; selected: ToolchainData.optimizer == 0; clicked => { ToolchainData.optimizer = 0; } }
            DockTab { label: "On"; selected: ToolchainData.optimizer == 1; clicked => { ToolchainData.optimizer = 1; } }
            DockTab { label: "Off"; selected: ToolchainData.optimizer == 2; clicked => { ToolchainData.optimizer = 2; } }
            LineEdit { text <=> ToolchainData.optimizer-runs; placeholder-text: "runs (200)"; font-size: 0.8125rem; width: 7rem; }
            DockTab { label: "via-IR"; selected: ToolchainData.via-ir; clicked => { ToolchainData.via-ir = !ToolchainData.via-ir; } }
            LineEdit { text <=> ToolchainData.evm-version; placeholder-text: "evm (default)"; font-size: 0.8125rem; width: 8rem; }
            LineEdit { text <=> ToolchainData.bytecode-hash; placeholder-text: "metadata hash (ipfs)"; font-size: 0.8125rem; width: 10rem; }
            IconButton { icon: @image-url("icons/refresh.svg"); label: "Save settings and recompile"; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.save-settings(ToolchainData.optimizer, ToolchainData.optimizer-runs, ToolchainData.via-ir, ToolchainData.evm-version, ToolchainData.bytecode-hash); } }
        }
        SideHeader { title: "Installed"; trailing: "click to use"; }
        if ToolchainData.installed-solc.length == 0: SelectableText { text: "No solc installed yet. One is downloaded on the first compile."; color: Theme.faint; font-size: 0.75rem; }
        FlexboxLayout {
            spacing: 0.25rem;
            for version in ToolchainData.installed-solc: DockTab {
                label: version; selected: ToolchainData.locked == version;
                min-width: self.preferred-width;
                clicked => { ToolchainData.solc-input = version; }
            }
        }
        SideHeader { title: "Pragmas in this project"; }
        for row in ToolchainData.pragmas: HorizontalLayout {
            spacing: 0.75rem;
            Text { text: row.file; color: Theme.text; font-family: "Cascadia Mono"; font-size: 0.75rem; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
            Text { text: row.pragma; color: Theme.muted; font-family: "Cascadia Mono"; font-size: 0.75rem; horizontal-stretch: 0; }
        }

        Rectangle { height: 1px; background: Theme.line; }
        SelectableText { text: "Libraries"; font-weight: 600; font-size: 0.9375rem; }
        SelectableText { text: "Each version is downloaded once with git into \{ToolchainData.lib-folder} and shared by every project. Use maps the import prefix to it in this project's remappings."; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 0.375rem;
            Text { text: "Version tag"; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; }
            LineEdit { text <=> ToolchainData.tag-input; placeholder-text: "empty for the default release"; font-size: 0.8125rem; width: 14rem; }
        }
        for library in ToolchainData.libraries: Rectangle {
            height: library-row.preferred-height;
            background: library.missing ? #e0af6822 : Theme.panel;
            library-row := HorizontalLayout {
                padding: 0.5rem; padding-left: Theme.pad; spacing: 0.5rem;
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 0.125rem;
                    HorizontalLayout {
                        spacing: 0.5rem;
                        Text { text: library.title; color: Theme.text; font-size: 0.8125rem; font-weight: 600; horizontal-stretch: 0; }
                        Text { text: library.prefix; color: Theme.muted; font-family: "Cascadia Mono"; font-size: 0.75rem; horizontal-stretch: 1; overflow: elide; min-width: 0px; }
                    }
                    Text {
                        text: library.missing ? "Imported by this project but not mapped. Install, then Use."
                            : library.used != "" ? "Used in this project: \{library.used}"
                            : "Not used in this project.";
                        color: library.missing ? Theme.warn : Theme.muted; font-size: 0.75rem;
                    }
                    Text { text: library.installed == "" ? "Not installed." : "Installed: \{library.installed}"; color: Theme.faint; font-family: "Cascadia Mono"; font-size: 0.6875rem; overflow: elide; min-width: 0px; }
                }
                Small { text: ToolchainData.busy ? "Working…" : "Install"; enabled: !ToolchainData.busy; clicked => { ToolchainLogic.install(library.id, ToolchainData.tag-input); } }
                Small { text: "Use"; enabled: !ToolchainData.busy && library.installed != ""; clicked => { ToolchainLogic.use-version(library.id, ToolchainData.tag-input); } }
                Small { text: "Remove"; enabled: !ToolchainData.busy && library.used != ""; clicked => { ToolchainLogic.remove(library.id); } }
            }
        }
    }
}
