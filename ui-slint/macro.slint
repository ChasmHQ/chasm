import { ListView, ScrollView, TextEdit } from "scroll.slint";
import { ActionControl, SideRow, Theme } from "theme.slint";
import { SelectableText } from "selectable-text.slint";

export struct MacroRow { id: string, name: string, detail: string }
export struct MacroStep {
    name: string,
    kind: string,
    enabled: bool,
    status: string,
    duration: string,
    public-result: string,
    action-hint: string,
}
export struct MacroResult { id: string, title: string, status: string, duration: string }

export global MacroData {
    in property <[MacroRow]> macros;
    in property <int> selected: -1;
    in property <string> selected-id;
    in property <string> selected-name;
    in property <string> summary;
    in-out property <string> definition-json;
    in property <string> validation;
    in property <bool> validation-failed;
    in property <string> validated-id;
    in property <string> validated-json;
    in-out property <bool> validation-ready;
    in property <string> preflight-status;
    in property <string> preflight-broadcast;
    in property <string> preflight-read;
    in property <string> preflight-sweep;
    in property <string> preflight-signers;
    in property <string> preflight-snapshot;
    in property <string> status;
    in property <bool> loading;
    in property <bool> failed;
    in property <string> error;
    in property <bool> run-busy;
    in property <bool> can-run;
    in property <bool> can-dry-run;
    in property <[MacroStep]> steps;
    in property <[MacroResult]> results;
    in property <int> selected-result: -1;
    in property <string> result-simple;
    in property <string> result-raw;
    in property <string> run-log;
    in property <string> evidence-status;
    in property <bool> can-save-evidence;
}

export global MacroLogic {
    callback select(int);
    callback new-macro();
    callback duplicate();
    callback delete-macro(string);
    callback edited(string);
    callback validate();
    callback dry-run();
    callback run();
    callback cancel();
    callback import-macro();
    callback export-macro();
    callback select-result(int);
    callback save-evidence();
}

component MacroButton inherits ActionControl {
    height: max(2.75rem, Theme.control-height);
    min-width: button-content.min-width;
    preferred-width: button-content.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    border-width: root.has-focus ? 2px : 1px;
    border-color: root.has-focus && root.enabled ? (root.primary ? Theme.accent-ink : Theme.accent) : root.enabled && !root.primary ? Theme.muted : transparent;
    button-content := HorizontalLayout {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        Text {
            text: root.label;
            color: !root.enabled ? Theme.faint : root.primary ? Theme.accent-ink : Theme.text;
            font-size: 0.8125rem;
            vertical-alignment: center;
            horizontal-stretch: 0;
            accessible-role: none;
        }
    }
}

component PreflightLine inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 0.125rem;
    SelectableText { text: root.label; color: Theme.muted; font-size: 0.75rem; }
    SelectableText { text: root.value == "" ? "Unknown" : root.value; color: Theme.text; font-size: 0.8125rem; wrap: word-wrap; }
}

component MacroStepRow inherits Rectangle {
    in property <int> number;
    in property <MacroStep> step;
    min-width: 0px;
    vertical-stretch: 0;
    background: Theme.panel;
    border-radius: Theme.radius;
    VerticalLayout {
        padding: 0.625rem;
        spacing: 0.25rem;
        SelectableText {
            text: "\{root.number}. " + (root.step.name == "" ? "Unnamed step" : root.step.name);
            color: Theme.text;
            font-size: 0.875rem;
            font-weight: 600;
            wrap: word-wrap;
        }
        SelectableText {
            text: "Kind: " + (root.step.kind == "" ? "Unknown" : root.step.kind)
                + (root.step.enabled ? " | Enabled" : " | Disabled")
                + " | Status: " + (root.step.status == "" ? "Unknown" : root.step.status)
                + " | Duration: " + (root.step.duration == "" ? "Unknown" : root.step.duration);
            color: Theme.muted;
            font-size: 0.75rem;
            wrap: word-wrap;
        }
        SelectableText {
            text: "Public result: " + (root.step.public-result == "" ? "Not reported" : root.step.public-result);
            color: Theme.text;
            font-size: 0.8125rem;
            wrap: word-wrap;
        }
        SelectableText {
            text: "Action: " + (root.step.action-hint == "" ? "Not reported" : root.step.action-hint);
            color: Theme.muted;
            font-size: 0.75rem;
            wrap: word-wrap;
        }
    }
}

export component MacroWorkspace inherits ScrollView {
    private property <bool> editor-open: false;
    private property <bool> show-raw: false;
    private property <bool> confirming-delete: false;
    private property <int> delete-index: -1;
    private property <string> delete-id;
    private property <bool> has-selection: MacroData.selected >= 0 && MacroData.selected < MacroData.macros.length;
    private property <bool> validation-current: MacroData.validation-ready
        && MacroData.selected-id != ""
        && MacroData.validated-id == MacroData.selected-id
        && MacroData.validated-json == MacroData.definition-json;
    function invalidate-validation() { MacroData.validation-ready = false; }
    private property <int> selected-index: MacroData.selected;
    private property <string> selected-id: MacroData.selected-id;
    private property <bool> data-loading: MacroData.loading;
    private property <bool> data-run-busy: MacroData.run-busy;
    changed selected-index => { root.confirming-delete = false; }
    changed selected-id => { root.confirming-delete = false; }
    changed has-selection => { root.confirming-delete = false; }
    changed data-loading => { root.confirming-delete = false; }
    changed data-run-busy => { root.confirming-delete = false; }
    min-width: 0px;
    min-height: 0px;
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;

    VerticalLayout {
        padding: Theme.pad;
        spacing: 0.75rem;
        alignment: start;

        SelectableText {
            text: "Macros";
            color: Theme.text;
            font-size: 1rem;
            font-weight: 600;
        }
        SelectableText {
            text: "Local only: macro execution is intended for an Anvil node owned by this workspace. Review preflight before running.";
            color: Theme.muted;
            font-size: 0.8125rem;
            wrap: word-wrap;
        }
        if MacroData.loading: SelectableText {
            text: "Loading macros...";
            color: Theme.muted;
            font-size: 0.8125rem;
        }
        if MacroData.failed: SelectableText {
            text: MacroData.error == "" ? "Macro operation failed. Review the status and try again." : "Macro error: \{MacroData.error}";
            color: Theme.danger;
            font-size: 0.8125rem;
            wrap: word-wrap;
        }
        if MacroData.status != "": SelectableText {
            text: "Status: \{MacroData.status}";
            color: Theme.muted;
            font-size: 0.8125rem;
            wrap: word-wrap;
        }

        FlexboxLayout {
            spacing: 0.375rem;
            alignment: start;
            MacroButton { label: "New"; accessible-label: "New macro"; enabled: !MacroData.loading && !MacroData.run-busy; clicked => { root.confirming-delete = false; root.invalidate-validation(); MacroLogic.new-macro(); } }
            MacroButton { label: "Import"; accessible-label: "Import macro"; enabled: !MacroData.loading && !MacroData.run-busy; clicked => { root.confirming-delete = false; root.invalidate-validation(); MacroLogic.import-macro(); } }
            MacroButton { label: "Duplicate"; accessible-label: "Duplicate macro"; enabled: root.has-selection && !MacroData.loading && !MacroData.run-busy; clicked => { root.confirming-delete = false; root.invalidate-validation(); MacroLogic.duplicate(); } }
            MacroButton { label: "Export"; accessible-label: "Export macro"; enabled: root.has-selection && !MacroData.loading && !MacroData.run-busy; clicked => { MacroLogic.export-macro(); } }
            MacroButton { label: "Delete"; accessible-label: "Delete macro"; enabled: root.has-selection && MacroData.selected-id != "" && !MacroData.loading && !MacroData.run-busy; clicked => { root.delete-index = MacroData.selected; root.delete-id = MacroData.selected-id; root.confirming-delete = true; } }
        }
        if root.confirming-delete && root.has-selection && !MacroData.loading && !MacroData.run-busy && root.delete-index == MacroData.selected && root.delete-id == MacroData.selected-id: VerticalLayout {
            spacing: 0.375rem;
            SelectableText { text: "Delete " + (MacroData.selected-name == "" ? "the selected macro" : MacroData.selected-name) + "? This cannot be undone."; color: Theme.danger; font-size: 0.8125rem; wrap: word-wrap; }
            FlexboxLayout {
                spacing: 0.375rem;
                MacroButton { label: "Keep macro"; clicked => { root.confirming-delete = false; } }
                MacroButton { label: "Confirm delete"; clicked => { root.confirming-delete = false; root.invalidate-validation(); MacroLogic.delete-macro(root.delete-id); } }
            }
        }

        SelectableText { text: "Macro library"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
        if !MacroData.loading && !MacroData.failed && MacroData.macros.length == 0: SelectableText {
            text: "No macros yet. Create one or import a macro definition, including a generated Black Tithe macro.";
            color: Theme.muted;
            font-size: 0.8125rem;
            wrap: word-wrap;
        }
        if MacroData.macros.length > 0: Rectangle {
            height: min(max(2.75rem, MacroData.macros.length * max(2.75rem, Theme.row-height)), 11rem);
            min-width: 0px;
            background: Theme.inset;
            border-width: 1px;
            border-color: Theme.muted;
            ListView {
                for item[index] in MacroData.macros: SideRow {
                    icon: @image-url("icons/macros.svg");
                    label: (item.name == "" ? "Unnamed macro" : item.name) + (item.detail == "" ? "" : " | \{item.detail}");
                    selected: index == MacroData.selected;
                    border-width: self.has-focus ? 2px : 1px;
                    height: max(2.75rem, Theme.row-height);
                    enabled: !MacroData.loading && !MacroData.run-busy;
                    clicked => { root.confirming-delete = false; root.invalidate-validation(); MacroLogic.select(index); }
                }
            }
        }
        if !MacroData.loading && MacroData.macros.length > 0 && !root.has-selection: SelectableText {
            text: "Select a macro to inspect its definition and run history.";
            color: Theme.muted;
            font-size: 0.8125rem;
            wrap: word-wrap;
        }

        if root.has-selection: VerticalLayout {
            spacing: 0.75rem;
            SelectableText {
                text: MacroData.selected-name == "" ? "Selected macro" : MacroData.selected-name;
                color: Theme.text;
                font-size: 1rem;
                font-weight: 600;
                wrap: word-wrap;
            }
            SelectableText {
                text: MacroData.summary == "" ? "No summary available." : MacroData.summary;
                color: Theme.muted;
                font-size: 0.8125rem;
                wrap: word-wrap;
            }
            FlexboxLayout {
                spacing: 0.375rem;
                alignment: start;
                MacroButton { label: "Validate"; accessible-label: "Validate macro"; enabled: !MacroData.loading && !MacroData.run-busy; clicked => { root.invalidate-validation(); MacroLogic.validate(); } }
                MacroButton { label: "Dry run"; accessible-label: "Dry run macro"; enabled: !MacroData.loading && !MacroData.run-busy && root.validation-current && MacroData.can-dry-run; clicked => { MacroLogic.dry-run(); } }
                MacroButton { label: "Run"; accessible-label: "Run macro"; primary: true; enabled: !MacroData.loading && !MacroData.run-busy && root.validation-current && MacroData.can-run; clicked => { MacroLogic.run(); } }
                MacroButton { label: "Cancel run"; enabled: MacroData.run-busy; clicked => { MacroLogic.cancel(); } }
            }
            if MacroData.run-busy: SelectableText { text: "Macro run in progress. Cancel requests the current run to stop."; color: Theme.accent; font-size: 0.8125rem; wrap: word-wrap; }
            SelectableText {
                text: !root.validation-current ? "Validation: awaiting a fresh result for this definition." : "Validation: " + (MacroData.validation == "" ? "Not validated" : MacroData.validation);
                color: root.validation-current && MacroData.validation-failed ? Theme.danger : Theme.muted;
                font-size: 0.8125rem;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: Theme.line; }
            SelectableText { text: "Preflight"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
            SelectableText {
                text: !root.validation-current ? "Preflight pending validation of the current definition." : MacroData.preflight-status == "" ? "Preflight has not been reported. Validate the current definition before running." : MacroData.preflight-status;
                color: Theme.muted;
                font-size: 0.8125rem;
                wrap: word-wrap;
            }
            PreflightLine { label: "Broadcast"; value: !root.validation-current ? "" : MacroData.preflight-broadcast; }
            PreflightLine { label: "Read"; value: !root.validation-current ? "" : MacroData.preflight-read; }
            PreflightLine { label: "Sweep"; value: !root.validation-current ? "" : MacroData.preflight-sweep; }
            PreflightLine { label: "Signers"; value: !root.validation-current ? "" : MacroData.preflight-signers; }
            PreflightLine { label: "Snapshot"; value: !root.validation-current ? "" : MacroData.preflight-snapshot; }

            Rectangle { height: 1px; background: Theme.line; }
            SelectableText { text: "Ordered steps"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
            if !root.validation-current || MacroData.steps.length == 0: SelectableText {
                text: !root.validation-current ? "Steps are awaiting validation of the current definition." : "No steps are available. Validate the definition to update this list.";
                color: Theme.muted;
                font-size: 0.8125rem;
                wrap: word-wrap;
            }
            if root.validation-current: VerticalLayout {
                spacing: 0.375rem;
                for entry[index] in MacroData.steps: MacroStepRow { number: index + 1; step: entry; }
            }

            Rectangle { height: 1px; background: Theme.line; }
            FlexboxLayout {
                spacing: 0.375rem;
                alignment: start;
                MacroButton {
                    label: root.editor-open ? "Hide JSON editor" : "Edit definition JSON";
                    checkable: true;
                    selected: root.editor-open;
                    clicked => { root.editor-open = !root.editor-open; }
                }
            }
            if root.editor-open: VerticalLayout {
                spacing: 0.375rem;
                SelectableText { text: "Macro definition JSON"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
                SelectableText { text: "Edit the complete typed definition here, then validate it. The ordered step list is read-only."; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; }
                Rectangle {
                    height: 15rem;
                    min-width: 0px;
                    editor := TextEdit {
                        width: parent.width;
                        height: parent.height;
                        text <=> MacroData.definition-json;
                        edited => { root.invalidate-validation(); MacroLogic.edited(self.text); }
                        enabled: !MacroData.loading && !MacroData.run-busy;
                        accessible-label: "Macro definition JSON";
                        font-family: "Cascadia Mono";
                        font-size: 0.8125rem;
                        wrap: word-wrap;
                    }
                    Rectangle { border-width: editor.has-focus ? 2px : 1px; border-color: editor.has-focus ? Theme.accent : Theme.muted; background: transparent; }
                }
            }

            Rectangle { height: 1px; background: Theme.line; }
            SelectableText { text: "Run log and output"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
            if MacroData.results.length == 0: SelectableText {
                text: MacroData.loading ? "Loading run results..." : MacroData.failed ? "Run results are unavailable. Review the error above and retry." : MacroData.run-busy ? "Waiting for run results..." : "No run results yet. Run or dry run this macro to see output.";
                color: Theme.muted;
                font-size: 0.8125rem;
                wrap: word-wrap;
            }
            if MacroData.results.length > 0: Rectangle {
                height: min(max(2.75rem, MacroData.results.length * max(2.75rem, Theme.row-height)), 11rem);
                min-width: 0px;
                background: Theme.inset;
                border-width: 1px;
                border-color: Theme.muted;
                ListView {
                    for item[index] in MacroData.results: SideRow {
                        icon: @image-url("icons/logs.svg");
                        label: (item.title == "" ? "Run result" : item.title) + " | " + (item.status == "" ? "Unknown" : item.status) + (item.duration == "" ? "" : " | \{item.duration}");
                        selected: index == MacroData.selected-result;
                        border-width: self.has-focus ? 2px : 1px;
                        height: max(2.75rem, Theme.row-height);
                        clicked => { MacroLogic.select-result(index); }
                    }
                }
            }
            if MacroData.results.length > 0 && (MacroData.selected-result < 0 || MacroData.selected-result >= MacroData.results.length): SelectableText {
                text: "Select a result to inspect its output.";
                color: Theme.muted;
                font-size: 0.8125rem;
                wrap: word-wrap;
            }
            if MacroData.selected-result >= 0 && MacroData.selected-result < MacroData.results.length: VerticalLayout {
                spacing: 0.375rem;
                FlexboxLayout {
                    spacing: 0.375rem;
                    MacroButton { label: "Simple output"; checkable: true; selected: !root.show-raw; clicked => { root.show-raw = false; } }
                    MacroButton { label: "Raw output"; checkable: true; selected: root.show-raw; clicked => { root.show-raw = true; } }
                    MacroButton { label: "Save evidence"; enabled: MacroData.can-save-evidence && !MacroData.run-busy; clicked => { MacroLogic.save-evidence(); } }
                }
                SelectableText {
                    text: "Evidence: " + (MacroData.evidence-status == "" ? "Unknown" : MacroData.evidence-status);
                    color: Theme.muted;
                    font-size: 0.8125rem;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 12rem;
                    min-width: 0px;
                    output := TextEdit {
                        width: parent.width;
                        height: parent.height;
                        text: root.show-raw ? (MacroData.result-raw == "" ? "No raw output reported." : MacroData.result-raw) : (MacroData.result-simple == "" ? "No simple output reported." : MacroData.result-simple);
                        read-only: true;
                        accessible-label: root.show-raw ? "Raw run output" : "Simple run output";
                        font-family: "Cascadia Mono";
                        font-size: 0.75rem;
                        wrap: word-wrap;
                    }
                    Rectangle { border-width: output.has-focus ? 2px : 1px; border-color: output.has-focus ? Theme.accent : Theme.muted; background: transparent; }
                }
            }
            SelectableText { text: "Run log"; color: Theme.text; font-size: 0.8125rem; font-weight: 600; }
            Rectangle {
                height: 8rem;
                min-width: 0px;
                log := TextEdit {
                    width: parent.width;
                    height: parent.height;
                    text: MacroData.run-log == "" ? "No log entries reported." : MacroData.run-log;
                    read-only: true;
                    accessible-label: "Macro run log";
                    font-family: "Cascadia Mono";
                    font-size: 0.75rem;
                    wrap: word-wrap;
                }
                Rectangle { border-width: log.has-focus ? 2px : 1px; border-color: log.has-focus ? Theme.accent : Theme.muted; background: transparent; }
            }
        }
    }
}
