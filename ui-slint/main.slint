export struct ContractRow { name: string, kind: string }
export struct FunctionRow { name: string, inputs: string, mutability: string }
export struct InputRow { name: string, kind: string }
export struct DocTab { title: string, kind: int }
export struct LogLine { text: string }
export struct JobRow { id: string, name: string, status: string }
export struct DeploymentRow { name: string, address: string }
// One row of the workspace tree: a deployment header (function = -1) or one of its functions.
export struct InstanceRow { deployment: int, function: int, label: string, tag: string, address: string, selected: bool, expanded: bool, count: int }
export struct TextRow { text: string }
export struct ChainItem { title: string, detail: string, query: string }

