    in property <bool> deploy-busy: false;
    in-out property <string> deploy-value: "0";
    in-out property <string> storage-slot;
    in-out property <string> converter-input;
    in-out property <string> explorer-input;
    in property <string> deploy-output;
    in property <string> call-output;
    in property <string> storage-output;
    in property <string> converter-output;
    in property <string> explorer-result;
    in property <[ChainItem]> recent-blocks;
    in property <[ChainItem]> recent-transactions;
    in-out property <int> explorer-tab: 0;
    // Debugger view: 0 step debugger for workspace transactions, 1 offline engine.
