// Exported for the copy tests, which compose it into a test window.
export component Confirmation inherits Rectangle {
    in property <string> heading;
    in property <string> detail;
    in property <string> warning;
    in property <string> action-label;
    callback cancelled();
    callback confirmed();
    background: #00000088;
    forward-focus: cancel-button;
    init => { cancel-button.focus(); }
    TouchArea { clicked => { } scroll-event(event) => { return accept; } }
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab {
                if event.modifiers.shift || event.text == Key.Backtab {
                    if cancel-button.has-focus { confirm-button.focus(); }
                    else if confirm-button.has-focus { warning-text.focus(); }
                    else if warning-text.has-focus { detail-text.focus(); }
                    else if detail-text.has-focus { heading-text.focus(); }
                    else { cancel-button.focus(); }
                } else {
                    if cancel-button.has-focus { heading-text.focus(); }
                    else if heading-text.has-focus { detail-text.focus(); }
                    else if detail-text.has-focus { warning-text.focus(); }
                    else if warning-text.has-focus { confirm-button.focus(); }
                    else { cancel-button.focus(); }
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && (event.text == "a" || event.text == "A" || event.text == "c" || event.text == "C") { return reject; }
            if event.modifiers.control || event.modifiers.alt { return accept; }
            return reject;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(36rem, parent.width - 2 * Theme.pad);
            height: confirmation-content.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.edge;
            border-radius: Theme.radius;
            confirmation-content := VerticalLayout {
                padding: Theme.pad;
                spacing: 0.75rem;
                heading-text := SelectableText { text: root.heading; color: Theme.text; font-size: 1rem; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                detail-text := SelectableText { text: root.detail; color: Theme.text; font-size: 0.8125rem; wrap: word-wrap; min-width: 0px; }
                warning-text := SelectableText { text: root.warning; color: Theme.muted; font-size: 0.8125rem; wrap: word-wrap; min-width: 0px; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 0.5rem;
                    cancel-button := IconButton { icon: @image-url("icons/stop.svg"); label: "Cancel"; clicked => { root.cancelled(); } }
                    confirm-button := IconButton { icon: @image-url("icons/wallet.svg"); label: root.action-label; primary: true; clicked => { root.confirmed(); } }
                }
            }
        }
    }
}

component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder-text;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback accepted(string);
    callback edited(string);
    height: Theme.control-height;
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: input;
    input := LineEdit {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        font-size: 0.8125rem;
        enabled: root.enabled;
        input-type: root.input-type;
        placeholder-text: root.placeholder-text;
        accessible-label: root.label;
        text <=> root.text;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
    Rectangle {
        border-width: 1px;
        border-radius: Theme.radius;
        border-color: input.has-focus ? Theme.accent : Theme.edge;
        background: transparent;
    }
}

component OutputPane inherits Rectangle {
    in property <string> text;
    in property <brush> text-color: Theme.text;
    min-width: 0px;
    min-height: 0px;
    background: Theme.inset;
    border-width: 1px;
    border-color: Theme.edge;
    border-radius: Theme.radius;
    clip: true;
    VerticalLayout {
        padding: 1px;
        HorizontalLayout {
            alignment: end;
            spacing: 0.25rem;
            IconButton { icon: @image-url("icons/contracts.svg"); label: "Copy output"; enabled: root.text != ""; clicked => { output.select-all(); output.copy(); } }
            IconButton { icon: @image-url("icons/contracts.svg"); label: "Save output…"; enabled: root.text != ""; clicked => { Logic.save-output(root.text); } }
        }
        output := TextEdit {
            text: root.text;
            read-only: true;
            accessible-label: "Output";
            font-size: 0.75rem;
            font-family: "Cascadia Mono";
            wrap: word-wrap;
            min-width: 0px;
            min-height: 0px;
            vertical-stretch: 1;
        }
    }
}

component WalletWorkspace inherits ScrollView {
    min-width: 0px;
    min-height: 0px;
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    VerticalLayout {
        padding: Theme.pad;
        spacing: 0.5rem;
        alignment: start;
        SelectableText { text: "Wallet"; color: Theme.text; font-size: 1rem; font-weight: 600; }
        SelectableText { text: AppData.wallet-address == "" ? "No account unlocked." : "Unlocked address: \{AppData.wallet-address}"; color: AppData.wallet-address == "" ? Theme.muted : Theme.ok; font-size: 0.8125rem; wrap: word-wrap; }
        SelectableText { text: "Anvil development accounts"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
        SelectableText { text: "Public test accounts for the local Anvil node only."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; spacing: 0.5rem;
            IconButton { icon: @image-url("icons/play.svg"); label: "Anvil dev key #0"; enabled: !AppData.wallet-busy && !AppData.deploy-busy; clicked => { Logic.use-anvil-key(0); } }
            IconButton { icon: @image-url("icons/play.svg"); label: "Anvil dev key #1"; enabled: !AppData.wallet-busy && !AppData.deploy-busy; clicked => { Logic.use-anvil-key(1); } }
            IconButton { icon: @image-url("icons/play.svg"); label: "Anvil dev key #2"; enabled: !AppData.wallet-busy && !AppData.deploy-busy; clicked => { Logic.use-anvil-key(2); } }
        }
        SelectableText { text: "Keystore files"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
        SelectableText { text: AppData.keystore-folder; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; min-width: 0px; }
        HorizontalLayout {
            alignment: start; spacing: 0.5rem;
            IconButton { icon: @image-url("icons/wallet.svg"); label: "Open keystore folder"; enabled: !AppData.wallet-busy; clicked => { Logic.open-keystore-folder(); } }
            IconButton { icon: @image-url("icons/refresh.svg"); label: "Reload keystores"; enabled: !AppData.wallet-busy; clicked => { Logic.refresh-wallet(); } }
        }
        if AppData.keystore-error != "": SelectableText { text: AppData.keystore-error; color: Theme.danger; font-size: 0.75rem; wrap: word-wrap; min-width: 0px; }
        if AppData.keystores.length == 0: SelectableText { text: "No keystore files. Create or import one below, then reload."; color: Theme.muted; font-size: 0.75rem; wrap: word-wrap; }
        ListView {
            height: min(max(Theme.row-height, AppData.keystores.length * Theme.row-height), 8rem);
            min-width: 0px;
            for item[index] in AppData.keystores: SideRow { icon: @image-url("icons/wallet.svg"); label: item.text; enabled: !AppData.wallet-busy; selected: AppData.selected-keystore == item.text; clicked => { Logic.select-keystore(index); } }
        }
        SelectableText { text: AppData.selected-keystore == "" ? "Select a keystore file to unlock, show or delete it." : "Selected file: \{AppData.selected-keystore}"; color: Theme.muted; font-size: 0.75rem; wrap: word-wrap; }
        SelectableText { text: "Keystore password"; color: Theme.muted; font-size: 0.75rem; }
        HorizontalLayout {
            spacing: 0.5rem;
            Field { label: "Keystore password"; input-type: password; enabled: !AppData.wallet-busy; text <=> AppData.wallet-password; accepted => { if AppData.selected-keystore != "" && !AppData.wallet-busy { Logic.unlock-wallet(); } } }
            IconButton { icon: @image-url("icons/wallet.svg"); label: "Unlock keystore"; enabled: AppData.selected-keystore != "" && !AppData.wallet-busy; clicked => { Logic.unlock-wallet(); } }
        }
        SelectableText { text: "Private key stays in memory; the debugger never uses it."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; min-width: 0px; }
        HorizontalLayout {
            alignment: start; spacing: 0.5rem;
            IconButton { icon: @image-url("icons/wallet.svg"); label: "Show in folder"; enabled: AppData.selected-keystore != "" && !AppData.wallet-busy; clicked => { Logic.reveal-keystore(); } }
            IconButton { icon: @image-url("icons/stop.svg"); label: "Delete keystore…"; enabled: AppData.selected-keystore != "" && !AppData.wallet-busy; clicked => { Logic.request-delete-keystore(); } }
        }
        if AppData.wallet-busy: SelectableText { text: "Working on keystore…"; color: Theme.muted; font-size: 0.75rem; }
        Rectangle { height: 1px; background: Theme.edge; }
        SelectableText { text: "Create an encrypted keystore in ~/.foundry/keystores. The private key is never shown."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
        SelectableText { text: "Keystore name"; color: Theme.muted; font-size: 0.75rem; }
        Field { label: "Keystore name"; placeholder-text: "local-dev"; text <=> AppData.keystore-name; }
        SelectableText { text: "New keystore password"; color: Theme.muted; font-size: 0.75rem; }
        Field { label: "New keystore password"; input-type: password; text <=> AppData.keystore-password; }
        SelectableText { text: "Confirm password"; color: Theme.muted; font-size: 0.75rem; }
        Field { label: "Confirm password"; input-type: password; text <=> AppData.keystore-confirm; }
        SelectableText { text: "Existing private key (optional)"; color: Theme.muted; font-size: 0.75rem; }
        Field { label: "Existing private key"; input-type: password; placeholder-text: "Leave empty to generate a random key"; text <=> AppData.keystore-import; accepted => { Logic.create-keystore(); } }
        SelectableText { text: "Leave this empty to generate a key with Foundry's OS random generator. A typed key is imported and then cleared."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
        HorizontalLayout { alignment: start; IconButton { icon: @image-url("icons/wallet.svg"); label: "Create keystore"; primary: true; clicked => { Logic.create-keystore(); } } }
    }
}

component LogsView inherits Rectangle {
    min-width: 0px; min-height: 0px; background: Theme.inset;
    VerticalLayout {
        HorizontalLayout {
            spacing: 0.375rem;
            Field { label: "Filter logs"; placeholder-text: "Filter logs"; text <=> AppData.log-filter; edited => { Logic.filter-logs(self.text); } }
            IconButton { icon: @image-url("icons/stop.svg"); label: "Clear logs"; clicked => { Logic.clear-logs(); } }
        }
        TextEdit { text: AppData.log-text; placeholder-text: "No log messages yet."; accessible-label: "Logs"; read-only: true; font-family: "Cascadia Mono"; font-size: 0.75rem; wrap: word-wrap; min-width: 0px; min-height: 0px; vertical-stretch: 1; }
    }
}

component JobsView inherits ScrollView {
    min-width: 0px; min-height: 0px;
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    VerticalLayout {
        padding: Theme.pad; spacing: 0.375rem; alignment: start;
        if AppData.jobs.length == 0: SelectableText { text: "No jobs in this session. Compiles, deploys, sends and chain reads show up here while they run."; color: Theme.faint; font-size: 0.75rem; }
        for job in AppData.jobs: SideRow { icon: @image-url("icons/play.svg"); label: job.name; trailing: job.status; clicked => { Logic.select-job(job.id); } }
        OutputPane { text: AppData.job-output; height: 8rem; }
    }
}

// Deployment headers carry the address and a remove button; function rows sit
// under them with a VIEW/PAY/TX tag so one click opens the request.
component InstanceRowView inherits ActionControl {
    in property <InstanceRow> item;
    label: root.item.function < 0 ? "\{root.item.label} at \{root.item.address}, \{root.item.expanded ? "expanded" : "collapsed"}" : "\{root.item.tag} \{root.item.label}";
    checkable: root.item.function >= 0;
    selected: root.item.selected;
    height: Theme.row-height;
    min-width: 0px;
    vertical-stretch: 0;
    clicked => { Logic.open-instance-function(root.item.deployment, root.item.function); }
    HorizontalLayout {
        padding-left: root.item.function < 0 ? Theme.pad : Theme.pad + 0.875rem;
        padding-right: root.item.function < 0 ? 0.25rem : Theme.pad;
        spacing: 0.375rem;
        if root.item.function < 0: TouchArea {
            width: 1rem;
            mouse-cursor: pointer;
            clicked => { Logic.toggle-instance(root.item.deployment); }
            Image {
                source: root.item.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                width: 0.875rem; height: 0.875rem; y: (parent.height - self.height) / 2;
                colorize: Theme.icon;
                accessible-role: none;
            }
        }
        if root.item.function >= 0: Rectangle {
            width: 2.5rem; height: 1rem; y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            border-width: 1px; border-radius: 2px;
            border-color: root.item.tag == "PAY" ? Theme.warn : Theme.edge;
            Text { text: root.item.tag; font-family: "Cascadia Mono"; font-size: 0.625rem; color: root.item.tag == "PAY" ? Theme.warn : Theme.muted; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
        }
        Text {
            text: root.item.label;
            font-family: root.item.function < 0 ? "Segoe UI" : "Cascadia Mono";
            font-size: root.item.function < 0 ? 0.8125rem : 0.75rem;
            color: root.item.selected ? Theme.text : root.item.function < 0 ? Theme.text : Theme.muted;
            vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide;
            accessible-role: none;
        }
        if root.item.function < 0 && !root.item.expanded: Text {
            text: "\{root.item.count} fn";
            font-size: 0.6875rem; color: Theme.faint;
            vertical-alignment: center; horizontal-stretch: 0; accessible-role: none;
        }
        if root.item.function < 0: Text {
            text: root.item.address;
            font-family: "Cascadia Mono"; font-size: 0.6875rem; color: Theme.faint;
            vertical-alignment: center; horizontal-stretch: 0; accessible-role: none;
        }
        if root.item.function < 0: IconButton {
            icon: @image-url("icons/stop.svg"); icon-only: true;
            label: "Remove deployment record \{root.item.label}";
            height: Theme.row-height; border-radius: 0px; transparent-background: !self.hovered;
            clicked => { Logic.remove-deployment(root.item.deployment); }
        }
    }
}

component NavigationView inherits Rectangle {
    min-width: 0px; min-height: 0px; background: Theme.rail;
    ScrollView {
        min-width: 0px; min-height: 0px; content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            spacing: 0.125rem; alignment: start;
            if AppData.activity == 0: VerticalLayout {
                SideHeader { title: "Contracts"; }
                if AppData.contracts.length == 0: SideNote { text: "Recompile to load workspace contracts."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
                ListView {
                    height: min(AppData.contracts.length * Theme.row-height, 10.5rem); min-width: 0px;
                    for row[index] in AppData.contracts: Rectangle {
                        height: Theme.row-height;
                        background: AppData.selected-contract == row.name ? Theme.selected : name-row.hovered || deploy-button.hovered ? Theme.hover : transparent;
                        HorizontalLayout {
                            name-row := SideRow { icon: @image-url("icons/contracts.svg"); label: row.name; transparent-background: true; selected: AppData.selected-contract == row.name; clicked => { Logic.select-contract(index); } }
                            deploy-button := IconButton {
                                icon: @image-url("icons/deploy.svg"); label: "Deploy"; accessible-label: "Deploy \{row.name}";
                                height: Theme.row-height; y: 0px; border-radius: 0px;
                                clicked => { Logic.select-contract(index); Logic.open-deploy(); }
                            }
                        }
                    }
                }
                SideRow { icon: @image-url("icons/contracts.svg"); label: AppData.template-open ? "Cancel new contract" : "New contract from template"; selected: AppData.template-open; clicked => { AppData.template-open = !AppData.template-open; } }
                if AppData.template-open: VerticalLayout {
                    padding-left: Theme.pad; padding-right: Theme.pad; padding-bottom: 0.375rem; spacing: 0.25rem;
                    LineEdit { text <=> AppData.template-name; placeholder-text: "Contract name, e.g. MyToken"; font-size: 0.8125rem; min-width: 0px; }
                    HorizontalLayout {
                        spacing: 0.25rem;
                        for template in [{ id: "erc20", label: "ERC20" }, { id: "erc721", label: "ERC721" }, { id: "ownable", label: "Ownable" }]: DockTab {
                            label: template.label; horizontal-stretch: 1;
                            enabled: AppData.template-name != "";
                            clicked => { Logic.new-from-template(template.id, AppData.template-name); }
                        }
                    }
                    SideNote { text: "Writes <name>.sol with OpenZeppelin v5, then recompiles."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
                }
                SideHeader { title: "Deployed"; trailing: AppData.deployments.length > 0 ? "\{AppData.deployments.length}" : ""; }
                if AppData.deployments.length == 0: SideNote { text: "Deploy a contract to call its functions here."; color: Theme.faint; font-size: 0.75rem; }
                for entry in AppData.instance-rows: InstanceRowView { item: entry; }
            }
            if AppData.activity == 1: VerticalLayout {
                SideHeader { title: "Chain"; }
                SideNote { text: AppData.block-label; color: Theme.text; wrap: word-wrap; }
                SideRow { icon: @image-url("icons/refresh.svg"); label: "Refresh chain"; clicked => { Logic.fetch-block(); } }
                SideRow { icon: @image-url("icons/search.svg"); label: "Investigation"; selected: AppData.explorer-tab == 1; clicked => { AppData.explorer-tab = 1; InvestigationLogic.open-embedded(); } }
                SideRow { icon: @image-url("icons/logs.svg"); label: "History"; selected: AppData.explorer-tab == 2; clicked => { AppData.explorer-tab = 2; } }
                SideRow { icon: @image-url("icons/storage.svg"); label: "Timeline and cheats"; selected: AppData.explorer-tab == 3; clicked => { AppData.explorer-tab = 3; } }
            }
            if AppData.activity == 2: VerticalLayout {
                SideHeader { title: "Tools"; }
                SideRow { icon: @image-url("icons/converter.svg"); label: "Hex"; clicked => { Logic.set-converter-tool(0); } }
                SideRow { icon: @image-url("icons/converter.svg"); label: "Units"; clicked => { Logic.set-converter-tool(1); } }
                SideRow { icon: @image-url("icons/converter.svg"); label: "Keccak"; clicked => { Logic.set-converter-tool(2); } }
                SideRow { icon: @image-url("icons/converter.svg"); label: "Selector"; clicked => { Logic.set-converter-tool(3); } }
            }
            if AppData.activity == 3: VerticalLayout {
                SideHeader { title: "Macros"; }
                SideRow { icon: @image-url("icons/macros.svg"); label: "New macro"; clicked => { Logic.new-macro(); } }
            }
            if AppData.activity == 4: VerticalLayout {
                SideHeader { title: "Debug"; }
                SideRow { icon: @image-url("icons/debugger.svg"); label: "Last transaction or call"; selected: AppData.debugger-mode == 0 && TraceData.loaded; clicked => { AppData.debugger-mode = 0; TraceLogic.load(""); } }
                SideRow { icon: @image-url("icons/search.svg"); label: "Choose a transaction"; selected: AppData.debugger-mode == 0 && !TraceData.loaded; clicked => { AppData.debugger-mode = 0; TraceLogic.clear(); } }
                SideNote { text: "Steps through what really ran on this workspace's node, mapped to your Solidity source."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
                SideHeader { title: "Offline engine"; }
                SideRow { icon: @image-url("icons/play.svg"); label: "Captures and Foundry tests"; selected: AppData.debugger-mode == 1; clicked => { AppData.debugger-mode = 1; } }
                if AppData.debugger-mode == 1: SideNote { text: AppData.debugger-label; color: AppData.debugger-tint; font-size: 0.75rem; wrap: word-wrap; }
            }
        }
    }
}

component DeployWorkspace inherits ScrollView {
    in property <string> owner;
    in property <string> title;
    in property <DeploymentView> view;
    min-width: 0px; min-height: 0px;
    content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
    VerticalLayout {
        padding: Theme.pad; spacing: 0.5rem; alignment: start;
        SelectableText { text: root.title; color: Theme.text; font-size: 1rem; font-weight: 600; wrap: word-wrap; }
        if root.view.fields.length > 0: SelectableText { text: "Enter each constructor argument separately. Use JSON for arrays and tuples."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
        SelectableText { text: "Constructor arguments"; color: Theme.text; font-size: 0.875rem; font-weight: 600; }
        if root.view.note != "": SelectableText { text: root.view.note; color: Theme.muted; font-size: 0.75rem; wrap: word-wrap; }
        for field[index] in root.view.fields: VerticalLayout {
            spacing: 0.375rem;
            SelectableText { text: "\{field.name} (\{field.kind})"; color: Theme.text; font-size: 0.8125rem; wrap: word-wrap; }
            Field { label: "\{field.name} (\{field.kind})"; placeholder-text: field.placeholder; text: field.value; edited => { PanelLogic.constructor-edited(root.owner, index, self.text); } }
            if field.hint != "": SelectableText { text: field.hint; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
            if field.error != "": SelectableText { text: "Error in \{field.name}: \{field.error}"; color: Theme.danger; font-size: 0.75rem; wrap: word-wrap; }
        }
        HorizontalLayout { alignment: start; IconButton { icon: @image-url("icons/refresh.svg"); label: "Reset constructor fields"; enabled: !root.view.busy; clicked => { PanelLogic.reset-constructor(root.owner); } } }
        SelectableText { text: "Deployment value (wei)"; color: Theme.muted; font-size: 0.75rem; }
        Field { label: "Deployment value (wei)"; text: root.view.value; edited => { PanelLogic.deployment-value-edited(root.owner, self.text); } }
        if root.view.value-error != "": SelectableText { text: "Deployment value error: \{root.view.value-error}"; color: Theme.danger; font-size: 0.75rem; wrap: word-wrap; }
        if !root.view.ready && root.view.block-reason != "": SelectableText { text: "Cannot deploy: \{root.view.block-reason}"; color: Theme.muted; font-size: 0.75rem; wrap: word-wrap; }
        HorizontalLayout { alignment: start; IconButton { icon: @image-url("icons/deploy.svg"); label: root.view.busy ? "Deploying…" : "Deploy to local Anvil"; primary: true; enabled: root.view.ready && !root.view.busy; clicked => { PanelLogic.deploy-contract(root.owner); } } }
        SelectableText { text: "Deployment output"; color: Theme.muted; font-size: 0.75rem; }
        OutputPane { text: root.view.output; height: 14rem; }
    }
}

component ChainList inherits Rectangle {
    in property <string> title;
    in property <[ChainItem]> items;
    in property <string> empty;
    in property <string> selected;
    min-width: 0px;
    background: Theme.panel;
    VerticalLayout {
        SideHeader { title: root.title; trailing: root.items.length > 0 ? "\{root.items.length}" : ""; }
        if root.items.length == 0: SideNote { text: root.empty; color: Theme.faint; font-size: 0.75rem; }
        ListView {
            vertical-stretch: 1;
            for item in root.items: ActionControl {
                label: "\{item.title} \{item.detail}";
                checkable: true;
                selected: root.selected == item.query;
                height: 2.5rem;
                clicked => { Logic.explorer-open(item.query); }
                VerticalLayout {
                    padding-left: Theme.pad; padding-right: Theme.pad;
                    alignment: center;
                    Text { text: item.title; color: Theme.text; font-family: "Cascadia Mono"; font-size: 0.75rem; overflow: elide; min-width: 0px; }
                    Text { text: item.detail; color: Theme.muted; font-family: "Cascadia Mono"; font-size: 0.6875rem; overflow: elide; min-width: 0px; }
                }
            }
        }
    }
}

component ExplorerWorkspace inherits Rectangle {
    min-width: 0px; min-height: 0px;
    background: Theme.canvas;
    VerticalLayout {
        HorizontalLayout {
            height: Theme.tab-height;
            DockTab { label: "Chain"; selected: AppData.explorer-tab == 0; clicked => { AppData.explorer-tab = 0; } }
            DockTab { label: "Investigation"; selected: AppData.explorer-tab == 1; clicked => { AppData.explorer-tab = 1; InvestigationLogic.open-embedded(); } }
            DockTab { label: "History"; selected: AppData.explorer-tab == 2; clicked => { AppData.explorer-tab = 2; } }
            DockTab { label: "Timeline"; selected: AppData.explorer-tab == 3; clicked => { AppData.explorer-tab = 3; } }
            Rectangle { horizontal-stretch: 1; }
        }
        if AppData.explorer-tab == 0: VerticalLayout {
            padding: Theme.pad; spacing: 0.5rem;
            HorizontalLayout {
                spacing: 0.375rem;
                Field { label: "Search address, transaction hash, block hash or block number"; placeholder-text: "Address, tx hash, block hash or block number"; text <=> AppData.explorer-input; edited => { Logic.explorer-edited(self.text); } accepted => { Logic.explorer-search(self.text); } }
                IconButton { icon: @image-url("icons/search.svg"); label: "Look up"; primary: true; clicked => { Logic.explorer-search(AppData.explorer-input); } }
                IconButton { icon: @image-url("icons/refresh.svg"); label: "Refresh"; clicked => { Logic.fetch-block(); } }
                IconButton { icon: @image-url("icons/contracts.svg"); label: "Open verified contract"; enabled: AppData.explorer-input != ""; clicked => { Logic.import-contract(AppData.explorer-input); } }
            }
            SelectableText { text: "Lists show the newest 100 blocks and transactions on the workspace node. Search reaches anything older on the same node. Address history on public networks is not indexed yet."; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; }
            if AppData.explorer-status != "": SelectableText { text: AppData.explorer-status; color: Theme.muted; font-size: 0.75rem; }
            HorizontalLayout {
                spacing: 1px;
                vertical-stretch: 1;
                ChainList { title: "Blocks"; items: AppData.recent-blocks; empty: "No blocks loaded. Press Refresh, or open a project to start its node."; selected: AppData.explorer-input; width: 30%; }
                ChainList { title: "Transactions"; items: AppData.recent-transactions; empty: "No transactions yet. Deploy a contract or Send a function from the Contracts view."; selected: AppData.explorer-input; width: 35%; }
                OutputPane { text: AppData.explorer-result; horizontal-stretch: 1; }
            }
        }
        if AppData.explorer-tab == 1: InvestigationPanel { vertical-stretch: 1; }
        if AppData.explorer-tab == 2: HistoryView { vertical-stretch: 1; }
        if AppData.explorer-tab == 3: TimelineView { vertical-stretch: 1; }
    }
}

component ConverterWorkspace inherits ScrollView {
    min-width: 0px; min-height: 0px;
    content-width: self.visible-width; horizontal-scrollbar-policy: always-off;
    VerticalLayout {
        padding: Theme.pad; spacing: 0.625rem; alignment: start;
        SelectableText { text: "Converter"; color: Theme.text; font-size: 1rem; font-weight: 600; }
        SelectableText { text: AppData.converter-hint; color: Theme.faint; font-size: 0.75rem; wrap: word-wrap; min-width: 0px; }
        SelectableText { text: "Conversion mode"; color: Theme.muted; font-size: 0.75rem; }
        ComboBox { model: AppData.converter-modes; current-index: AppData.converter-mode; accessible-label: "Conversion mode"; selected(value) => { Logic.set-converter-mode(self.current-index); } }
        SelectableText { text: "Value to convert"; color: Theme.muted; font-size: 0.75rem; }
        Field { label: "Value to convert"; text <=> AppData.converter-input; edited => { Logic.converter-edited(self.text); } }
        if AppData.converter-error != "": SelectableText { text: AppData.converter-error; color: Theme.danger; font-size: 0.8125rem; wrap: word-wrap; min-width: 0px; }
        OutputPane { text: AppData.converter-output; height: 16rem; }
    }
}

component WorkspacePane inherits Rectangle {
    in property <int> kind: -1;
    in property <string> owner;
    in property <int> document-kind;
    in property <string> document-title;
    in property <string> document-body;
    in property <ContractViewData> contract-view;
    in property <DeploymentView> deployment-view;
    min-width: 0px; min-height: 0px; background: Theme.canvas;
    if root.kind == 0: NavigationView { }
    // No tab open: say what to do instead of showing a blank pane.
    if root.kind == 1 && root.document-kind < 0: VerticalLayout {
        padding: Theme.pad * 2; spacing: 0.5rem; alignment: start;
        SelectableText { text: "No tab open"; font-size: 1rem; font-weight: 600; }
        SelectableText { text: AppData.compile-label == "Compile failed" ? "The workspace did not compile. Fix the error in the notice below, then Recompile (Ctrl+B)." : AppData.contracts.length == 0 ? "This folder has no Solidity contracts yet. Add a .sol file, then Recompile (Ctrl+B)." : "Pick a contract in the sidebar to open it, or a deployed function to call it. Ctrl+K finds anything by name."; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start; spacing: 0.375rem;
            IconButton { icon: @image-url("icons/search.svg"); label: "Go to… (Ctrl+K)"; clicked => { PaletteData.query = ""; PaletteData.selected = 0; PaletteData.open = true; PaletteLogic.query-edited(""); } }
            IconButton { icon: @image-url("icons/refresh.svg"); label: "Recompile"; clicked => { Logic.recompile(); } }
        }
    }
    if root.kind == 1 && root.document-kind == 0: ContractWorkspace { view: root.contract-view; owner: root.owner; }
    if root.kind == 1 && root.document-kind == 1 && root.owner != "": DeployWorkspace { view: root.deployment-view; owner: root.owner; title: root.document-title; }
    if root.kind == 1 && root.document-kind == 1 && root.owner == "": VerticalLayout {
        padding: Theme.pad; alignment: start;
        SelectableText { text: "Select a deployment document to edit its constructor."; color: Theme.muted; wrap: word-wrap; }
    }
    if root.kind == 1 && root.document-kind == 2: WalletWorkspace { }
    if root.kind == 1 && root.document-kind == 3: VerticalLayout {
        padding: Theme.pad; spacing: 0.5rem;
        SelectableText { text: root.document-title; color: Theme.text; font-size: 1rem; font-weight: 600; }
        OutputPane { text: root.document-body; vertical-stretch: 1; }
    }
    if root.kind == 1 && root.document-kind == 4: ExplorerWorkspace { }
    if root.kind == 1 && root.document-kind == 5: ConverterWorkspace { }
    if root.kind == 1 && root.document-kind == 6: MacroWorkspace { }
    if root.kind == 1 && root.document-kind == 7: FoundryWorkspace { }
    if root.kind == 1 && root.document-kind == 8: ToolchainWorkspace { }
    if root.kind == 2: ContractResult { view: root.contract-view; owner: root.owner; }
    if root.kind == 3: ContractStorage { view: root.contract-view; owner: root.owner; }
    if root.kind == 4: DebugCodePane { }
    if root.kind == 5: DebugInspectorPane { }
    if root.kind == 6: DebugInspectionPane { }
    if root.kind == 7: DebugSessionPane { }
    if root.kind == 8: ConsoleView { }
    if root.kind == 9: LogsView { }
    if root.kind == 10: JobsView { }
    if root.kind == 11: InvestigationPanel { }
    if root.kind == 12: TraceOpsPane { }
    if root.kind == 13: TraceStatePane { }
    if root.kind == 14: TraceConsolePane { }
}

component PanelZone inherits Rectangle {
    in property <int> zone;
    in property <[PanelRow]> tabs;
    in property <string> active;
    in property <string> title;
    in property <string> owner;
    in property <int> kind: -1;
    in property <int> document-kind;
    in property <string> document-title;
    in property <string> document-body;
    in property <ContractViewData> contract-view;
    in property <DeploymentView> deployment-view;
    in property <int> active-index: 0;
    in-out property <int> drag-target-index: -1;
    out property <length> zone-x: self.absolute-position.x;
    out property <length> zone-y: self.absolute-position.y;
    callback geometry-changed(int, length, length, length, length);
    changed zone-x => { root.geometry-changed(root.zone, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    changed zone-y => { root.geometry-changed(root.zone, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    changed width => { root.geometry-changed(root.zone, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    changed height => { root.geometry-changed(root.zone, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    init => { root.geometry-changed(root.zone, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    min-width: 0px; min-height: 0px;
    border-width: PanelData.dragging && PanelData.drag-x >= self.absolute-position.x && PanelData.drag-x < self.absolute-position.x + self.width && PanelData.drag-y >= self.absolute-position.y && PanelData.drag-y < self.absolute-position.y + self.height ? 2px : 0px;
    border-color: Theme.accent;
    background: Theme.panel;
    VerticalLayout {
        min-width: 0px; min-height: 0px;
        if root.tabs.length <= 1: PanelHeader { title: root.title; pane-id: root.active; zone: root.zone; tab-index: root.active-index; tab-count: root.tabs.length; }
        if root.tabs.length > 1: HorizontalLayout {
            height: Theme.tab-height; min-width: 0px;
            pane-strip := Rectangle {
                // Fixed size hints keep the tabs' widths from feeding back into this strip.
                min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; clip: true;
                // Each tab wants label + both DockTab paddings + the drag grip. When the
                // header is too narrow the active tab keeps up to half of it and the
                // others share the rest, eliding their labels instead of cutting glyphs.
                property <length> fair: self.width / max(1, root.tabs.length);
                property <length> active-share: max(self.fair, self.width / 2);
                property <length> other-share: max(3rem, (self.width - self.active-share) / max(1, root.tabs.length - 1));
                pane-tabs := HorizontalLayout {
                    x: 0px; width: parent.width; height: parent.height;
                    alignment: start;
                    for tab[index] in root.tabs: Rectangle {
                        width: min(max(5rem, tab-label.preferred-width + 2 * Theme.pad + 1.25rem), tab.active ? pane-strip.active-share : pane-strip.other-share);
                        height: Theme.tab-height; horizontal-stretch: 0;
                        property <bool> drag-hit: PanelData.dragging && PanelData.drag-x >= self.absolute-position.x && PanelData.drag-x < self.absolute-position.x + self.width && PanelData.drag-y >= self.absolute-position.y && PanelData.drag-y < self.absolute-position.y + self.height;
                        changed drag-hit => {
                            if self.drag-hit { root.drag-target-index = index; }
                            else if root.drag-target-index == index { root.drag-target-index = -1; }
                        }
                        // The highlight spans label and grip, so the whole tab reads as one control.
                        Rectangle {
                            background: tab.active ? Theme.selected : tab-hit.hovered || grip.hovered ? Theme.hover : transparent;
                        }
                        Rectangle {
                            y: parent.height - self.height; height: 2 * Theme.unit;
                            background: Theme.accent; visible: tab.active;
                        }
                        tab-hit := DockTab {
                            width: parent.width - 1.25rem; height: parent.height;
                            label: tab.title; selected: tab.active; flat: true;
                            clicked => { PanelLogic.select(tab.id, root.zone); }
                        }
                        tab-label := Text { text: tab.title; visible: false; font-size: 0.8125rem; }
                        grip := PanelDragHandle {
                            x: parent.width - self.width; width: 1.25rem; height: parent.height;
                            label: "Drag \{tab.title}"; icon: @image-url("icons/grip.svg"); icon-only: true; pane-id: tab.id;
                            clicked => { PanelLogic.select(tab.id, root.zone); }
                        }
                    }
                }
            }
            PanelHeader { title: ""; pane-id: root.active; zone: root.zone; tab-index: root.active-index; tab-count: root.tabs.length; compact: true; width: 2.5rem; horizontal-stretch: 0; }
        }
        WorkspacePane {
            kind: root.kind; owner: root.owner; document-kind: root.document-kind;
            document-title: root.document-title; document-body: root.document-body;
            contract-view: root.contract-view; deployment-view: root.deployment-view;
            vertical-stretch: 1;
        }
    }
}

export component MainWindow inherits Window {
    in property <bool> panel-host: false;
    in property <int> host-pane: 0;
    in property <string> host-owner;
    in-out property <string> hover-label;
    in-out property <length> hover-x;
    in-out property <length> hover-y;
    private property <bool> hover-visible: false;
    private property <bool> welcome-investigation: InvestigationData.visible && ((PanelData.left-visible && PanelData.left-kind == 11) || (PanelData.center-visible && PanelData.center-kind == 11) || (PanelData.right-visible && PanelData.right-kind == 11) || (PanelData.bottom-visible && PanelData.bottom-kind == 11));
    changed hover-label => { root.hover-visible = false; }
    Timer {
        interval: 500ms;
        running: root.hover-label != "" && !root.hover-visible;
        triggered => { root.hover-visible = true; }
    }
    // Space the two side zones may share; the center document keeps at least
    // 38% of the window (and 360px) at any zoom, so it is never squeezed shut.
    private property <length> side-cap: max(0px, min(PanelData.viewport-width * 0.62, PanelData.viewport-width - 360px));
    in-out property <int> deployment-menu-index: -1;
    in-out property <length> deployment-menu-x;
    in-out property <length> deployment-menu-y;
    private property <length> left-drop-x;
    private property <length> left-drop-y;
    private property <length> left-drop-width;
    private property <length> left-drop-height;
    private property <length> center-drop-x;
    private property <length> center-drop-y;
    private property <length> center-drop-width;
    private property <length> center-drop-height;
    private property <length> right-drop-x;
    private property <length> right-drop-y;
    private property <length> right-drop-width;
    private property <length> right-drop-height;
    private property <length> bottom-drop-x;
    private property <length> bottom-drop-y;
    private property <length> bottom-drop-width;
    private property <length> bottom-drop-height;
    private property <int> left-drop-index: -1;
    private property <int> center-drop-index: -1;
    private property <int> right-drop-index: -1;
    private property <int> bottom-drop-index: -1;
    function update-drop-zone(zone: int, x: length, y: length, width: length, height: length) {
        if zone == 0 { root.left-drop-x = x; root.left-drop-y = y; root.left-drop-width = width; root.left-drop-height = height; }
        if zone == 1 { root.center-drop-x = x; root.center-drop-y = y; root.center-drop-width = width; root.center-drop-height = height; }
        if zone == 2 { root.right-drop-x = x; root.right-drop-y = y; root.right-drop-width = width; root.right-drop-height = height; }
        if zone == 3 { root.bottom-drop-x = x; root.bottom-drop-y = y; root.bottom-drop-width = width; root.bottom-drop-height = height; }
    }
    function move-to-zone(pane: string, zone: int, target: int, count: int, active: string, active-index: int) {
        if target >= 0 && (active != pane || target != active-index) { PanelLogic.move(pane, zone, target); }
        else if target < 0 { PanelLogic.move(pane, zone, max(0, count - 1)); }
    }
    public function drop-pane(pane: string, x: length, y: length) {
        if root.panel-host || PanelData.blocked { return; }
        if PanelData.bottom-visible && (PanelData.maximized == "" || PanelData.maximized == PanelData.bottom-active) && x >= root.bottom-drop-x && x < root.bottom-drop-x + root.bottom-drop-width && y >= root.bottom-drop-y && y < root.bottom-drop-y + root.bottom-drop-height {
            PanelLogic.move(pane, 3, root.bottom-drop-index >= 0 ? root.bottom-drop-index : PanelData.bottom-tabs.length - 1);
        } else if PanelData.right-visible && (PanelData.maximized == "" || PanelData.maximized == PanelData.right-active) && x >= root.right-drop-x && x < root.right-drop-x + root.right-drop-width && y >= root.right-drop-y && y < root.right-drop-y + root.right-drop-height {
            PanelLogic.move(pane, 2, root.right-drop-index >= 0 ? root.right-drop-index : PanelData.right-tabs.length - 1);
        } else if PanelData.left-visible && (!AppData.sidebar-collapsed || PanelData.maximized == PanelData.left-active) && (PanelData.maximized == "" || PanelData.maximized == PanelData.left-active) && x >= root.left-drop-x && x < root.left-drop-x + root.left-drop-width && y >= root.left-drop-y && y < root.left-drop-y + root.left-drop-height {
            PanelLogic.move(pane, 0, root.left-drop-index >= 0 ? root.left-drop-index : PanelData.left-tabs.length - 1);
        } else if PanelData.center-visible && (PanelData.maximized == "" || PanelData.maximized == PanelData.center-active) && x >= root.center-drop-x && x < root.center-drop-x + root.center-drop-width && y >= root.center-drop-y && y < root.center-drop-y + root.center-drop-height {
            PanelLogic.move(pane, 1, root.center-drop-index >= 0 ? root.center-drop-index : PanelData.center-tabs.length - 1);
        }
    }
    title: root.panel-host && PanelData.pane-title != "" ? "Chasm - \{PanelData.pane-title}" : "Chasm";
    accessible-role: region;
    accessible-label: root.panel-host ? PanelData.pane-id : "Chasm workspace";
    preferred-width: root.panel-host ? 900px : 1360px;
    preferred-height: root.panel-host ? 650px : 820px;
    min-width: root.panel-host ? 420px : 1180px;
    min-height: root.panel-host ? 260px : 720px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    default-font-size: 16px * Theme.zoom;
    changed height => { PanelLogic.viewport-changed(); }
    changed width => { PanelLogic.viewport-changed(); }
    init => { Palette.color-scheme = ColorScheme.dark; }

    app-scope := FocusScope {
        visible: !root.panel-host;
        enabled: !root.panel-host && !PanelData.blocked && AppData.workspace-ready && !AutomationData.visible && AutomationData.approval-id == "";
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if PanelData.blocked { return accept; }
            if event.text == Key.Escape { root.hover-label = ""; }
            if event.text == Key.Escape && AppData.pending-keystore-delete != "" {
                Logic.cancel-delete-keystore();
                return accept;
            }
            if event.text == Key.Escape && AppData.pending-workspace != "" {
                Logic.cancel-open-folder();
                return accept;
            }
            if AppData.pending-keystore-delete != "" || AppData.pending-workspace != "" {
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && (event.text == "o" || event.text == "O") {
                Logic.open-folder();
                return accept;
            }
            if event.text == Key.Escape && AppData.menu-open >= 0 {
                Logic.close-menu();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && (event.text == "b" || event.text == "B") {
                Logic.recompile();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && (event.text == "k" || event.text == "K" || (event.modifiers.shift && (event.text == "p" || event.text == "P"))) {
                PaletteData.query = "";
                PaletteData.selected = 0;
                PaletteData.open = true;
                PaletteLogic.query-edited("");
                return accept;
            }
            // Tab and activity shortcuts. Ctrl+Enter sends from the request form.
            if event.modifiers.control && !event.modifiers.alt {
                if (event.text == "w" || event.text == "W") && AppData.active-document >= 0 {
                    Logic.close-document(AppData.active-document);
                    return accept;
                }
                if event.text == Key.Tab && AppData.documents.length > 1 {
                    Logic.select-document(event.modifiers.shift
                        ? Math.mod(AppData.active-document - 1 + AppData.documents.length, AppData.documents.length)
                        : Math.mod(AppData.active-document + 1, AppData.documents.length));
                    return accept;
                }
                if event.text == Key.Backtab && AppData.documents.length > 1 {
                    Logic.select-document(Math.mod(AppData.active-document - 1 + AppData.documents.length, AppData.documents.length));
                    return accept;
                }
                if event.text == Key.Return { Logic.send-call(); return accept; }
                if event.modifiers.shift && (event.text == "e" || event.text == "E") { Logic.simulate-call(); return accept; }
                if event.text == "1" { Logic.open-activity(0); return accept; }
                if event.text == "2" { Logic.open-activity(1); return accept; }
                if event.text == "3" { Logic.open-activity(2); return accept; }
                if event.text == "4" { Logic.open-activity(3); return accept; }
                if event.text == "5" { Logic.open-activity(4); return accept; }
                if event.text == "\\" { Logic.toggle-sidebar(); return accept; }
                if event.text == "/" || event.text == "?" { Logic.toggle-menu(5); return accept; }
            }
            // Debugger keys follow the usual IDE layout. They only act while a
            // paused session accepts commands, so they never type into fields.
            if AppData.activity == 4 && DebugData.can-command && !event.modifiers.control && !event.modifiers.alt {
                if event.text == Key.F5 && !event.modifiers.shift { DebugLogic.navigate("continue"); return accept; }
                if event.text == Key.F11 && event.modifiers.shift { DebugLogic.navigate("finish"); return accept; }
                if event.text == Key.F11 && DebugData.source-available { DebugLogic.navigate("step_line"); return accept; }
                if event.text == Key.F10 && DebugData.source-available { DebugLogic.navigate("next_line"); return accept; }
                if event.text == Key.F7 { DebugLogic.navigate("step_opcode"); return accept; }
                if event.text == Key.F9 && DebugData.breakpoint-here != "" { DebugLogic.breakpoint-here(); return accept; }
            }
            return reject;
        }
        Rectangle {
            VerticalLayout {
                Rectangle {
                    height: Theme.menu-height;
                    background: Theme.bar;
                    HorizontalLayout {
                        padding-left: 0.5rem;
                        spacing: 0px;
                        Rectangle {
                            width: 1rem;
                            horizontal-stretch: 0;
                            Image {
                                source: @image-url("icons/logo.svg");
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 1rem;
                                height: 1rem;
                                colorize: Theme.accent;
                                accessible-role: none;
                            }
                        }
                        SelectableText {
                            text: "Chasm";
                            color: Theme.text;
                            font-size: 0.8125rem;
                            font-weight: 600;
                            vertical-alignment: center;
                            width: 3rem;
                            horizontal-alignment: center;
                            horizontal-stretch: 0;
                        }
                        file-menu := MenuTitle { label: "File"; open: AppData.menu-open == 0; clicked => { Logic.toggle-menu(0); } pointer-entered(x, y) => { root.hover-label = "File"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                        workspace-menu := MenuTitle { label: "Workspace"; open: AppData.menu-open == 1; clicked => { Logic.toggle-menu(1); } pointer-entered(x, y) => { root.hover-label = "Workspace"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                        run-menu := MenuTitle { label: "Run"; open: AppData.menu-open == 2; clicked => { Logic.toggle-menu(2); } pointer-entered(x, y) => { root.hover-label = "Run"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                        view-menu := MenuTitle { label: "View"; open: AppData.menu-open == 3; clicked => { Logic.toggle-menu(3); } pointer-entered(x, y) => { root.hover-label = "View"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                        panels-menu := MenuTitle { label: "Panels"; open: AppData.menu-open == 6; clicked => { Logic.toggle-menu(6); } }
                        tools-menu := MenuTitle { label: "Tools"; open: AppData.menu-open == 4; clicked => { Logic.toggle-menu(4); } pointer-entered(x, y) => { root.hover-label = "Tools"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                        help-menu := MenuTitle { label: "Help"; accessible-description: "Ctrl+/"; open: AppData.menu-open == 5; clicked => { Logic.toggle-menu(5); } pointer-entered(x, y) => { root.hover-label = "Help"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                        SelectableText { text: AppData.status-left; color: Theme.faint; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; min-width: 0px; }
                        Rectangle { width: 0.5rem; horizontal-stretch: 0; }
                    }
                }

                if AppData.activity != 4: Rectangle {
                    height: Theme.toolbar-height;
                    background: Theme.panel;
                    ScrollView {
                        min-width: 0px;
                        min-height: 0px;
                        content-width: max(self.visible-width, toolbar-content.preferred-width);
                        content-height: self.visible-height;
                        vertical-scrollbar-policy: always-off;
                        toolbar-content := HorizontalLayout {
                            padding-left: 0.375rem;
                            padding-right: 0.5rem;
                            spacing: 0.25rem;
                            IconButton { icon: @image-url("icons/contracts.svg"); label: "Open project"; enabled: !AppData.workspace-busy && !AppData.folder-picker-busy; clicked => { Logic.open-folder(); } }
                            if AppData.activity == 0: IconButton { icon: @image-url("icons/refresh.svg"); label: "Recompile"; clicked => { Logic.recompile(); } }
                            if AppData.activity == 0: IconButton { icon: @image-url("icons/deploy.svg"); label: "Deploy"; enabled: AppData.selected-contract != ""; clicked => { Logic.open-deploy(); } }
                            if AppData.activity == 0: IconButton { icon: @image-url("icons/storage.svg"); label: "Open storage"; enabled: AppData.selected-contract != ""; clicked => { Logic.open-storage(); } }
                            Rectangle { width: 1px; background: Theme.edge; horizontal-stretch: 0; }
                            IconButton { icon: @image-url("icons/workspace.svg"); label: "Layout"; clicked => { Logic.toggle-menu(6); } }
                            Rectangle { horizontal-stretch: 1; }
                            SelectableText { text: AppData.mode-label; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                            SelectableText { text: AppData.chain-label; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                            SelectableText { text: AppData.block-label; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                        }
                    }
                }
                if AppData.debugger-mode == 1 && ((PanelData.left-kind >= 4 && PanelData.left-kind <= 7) || (PanelData.center-kind >= 4 && PanelData.center-kind <= 7) || (PanelData.right-kind >= 4 && PanelData.right-kind <= 7) || (PanelData.bottom-kind >= 4 && PanelData.bottom-kind <= 7)): DebugToolbar { }
                Rectangle { height: 1px; background: Theme.edge; }

                Rectangle {
                    min-height: 0px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        Rectangle {
                            width: Theme.rail-width;
                            horizontal-stretch: 0;
                            background: Theme.rail;
                            ScrollView {
                                min-width: 0px;
                                min-height: 0px;
                                content-width: self.visible-width;
                                content-height: max(self.visible-height, rail-content.preferred-height);
                                horizontal-scrollbar-policy: always-off;
                                rail-content := VerticalLayout {
                                    padding-top: 0.3125rem;
                                    spacing: 0.125rem;
                                    Rectangle {
                                        height: 2.375rem;
                                        Image {
                                            source: @image-url("icons/logo.svg");
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 1.25rem;
                                            height: 1.25rem;
                                            colorize: Theme.accent;
                                            accessible-role: none;
                                        }
                                    }
                                    RailIcon { icon: @image-url("icons/contracts.svg"); label: "Contracts"; selected: AppData.activity == 0; clicked => { Logic.open-activity(0); } pointer-entered(x, y) => { root.hover-label = "Contracts"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                                    RailIcon { icon: @image-url("icons/search.svg"); label: "Explorer"; selected: AppData.activity == 1; clicked => { Logic.open-activity(1); } pointer-entered(x, y) => { root.hover-label = "Explorer"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                                    RailIcon { icon: @image-url("icons/converter.svg"); label: "Converter"; selected: AppData.activity == 2; clicked => { Logic.open-activity(2); } pointer-entered(x, y) => { root.hover-label = "Converter"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                                    RailIcon { icon: @image-url("icons/macros.svg"); label: "Macros"; selected: AppData.activity == 3; clicked => { Logic.open-activity(3); } pointer-entered(x, y) => { root.hover-label = "Macros"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                                    RailIcon { icon: @image-url("icons/debugger.svg"); label: "Debugger"; selected: AppData.activity == 4; clicked => { Logic.open-activity(4); } pointer-entered(x, y) => { root.hover-label = "Debugger"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                                    Rectangle { vertical-stretch: 1; }
                                    RailIcon { icon: @image-url("icons/wallet.svg"); label: "Wallet"; selected: AppData.doc-kind == 2; clicked => { Logic.open-wallet(); } pointer-entered(x, y) => { root.hover-label = "Wallet"; root.hover-x = x; root.hover-y = y; } pointer-exited => { root.hover-label = ""; } }
                                }
                            }
                        }
                        Rectangle { width: 1px; background: Theme.edge; }

                        if PanelData.left-visible && (!AppData.sidebar-collapsed || PanelData.maximized == PanelData.left-active) && (PanelData.maximized == "" || PanelData.maximized == PanelData.left-active): PanelZone {
                            preferred-width: PanelData.maximized == PanelData.left-active ? 0px : min(PanelData.left-width * Theme.unit, 400 * Theme.unit, root.side-cap * 0.42);
                            horizontal-stretch: PanelData.maximized == PanelData.left-active ? 1 : 0;
                            geometry-changed(zone, x, y, width, height) => { root.update-drop-zone(zone, x, y, width, height); }
                            drag-target-index <=> root.left-drop-index;
                            zone: 0; tabs: PanelData.left-tabs; active: PanelData.left-active; active-index: PanelData.left-active-index;
                            kind: PanelData.left-kind; title: PanelData.left-title; owner: PanelData.left-owner;
                            document-kind: PanelData.left-document-kind; document-title: PanelData.left-document-title; document-body: PanelData.left-document-body;
                            contract-view: PanelData.left-contract; deployment-view: PanelData.left-deployment;
                        }
                        if PanelData.left-visible && !AppData.sidebar-collapsed && PanelData.maximized == "": Splitter {
                            zone: 0; extent: PanelData.left-width; width: 6 * Theme.unit; horizontal-stretch: 0;
                        }

                        if PanelData.maximized == "" || PanelData.maximized == PanelData.center-active || PanelData.maximized == PanelData.bottom-active: center-stack := Rectangle {
                            min-width: 0px;
                            min-height: 0px;
                            horizontal-stretch: 1;
                            background: Theme.canvas;
                            clip: true;
                            VerticalLayout {
                                if PanelData.maximized == "" && AppData.documents.length == 0: Rectangle {
                                    height: Theme.menu-height;
                                    background: Theme.canvas;
                                    HorizontalLayout {
                                        padding-left: Theme.pad;
                                        padding-right: Theme.pad;
                                        spacing: 0.625rem;
                                        SelectableText { text: AppData.heading; color: Theme.text; font-size: 0.8125rem; font-weight: 600; vertical-alignment: center; min-width: 0px; overflow: elide; horizontal-stretch: 1; }
                                        SelectableText { text: AppData.compile-label; color: Theme.faint; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                }
                                if PanelData.maximized == "" && AppData.documents.length > 0 && AppData.activity != 4: Rectangle {
                                    height: Theme.tab-height;
                                    background: Theme.bar;
                                    document-scroll := ScrollView {
                                        // Tabs share the strip down to a readable minimum; past that the
                                        // strip scrolls and keeps the active tab in view.
                                        property <length> chip: clamp(self.visible-width / max(1, AppData.documents.length) - 1px, 7rem, 10.625rem);
                                        property <int> active: AppData.active-document;
                                        // The active tab widens to show its whole title (text + inset + close button).
                                        property <length> active-chip: clamp(active-title.preferred-width + 3rem, self.chip, max(self.chip, self.visible-width / 2));
                                        active-title := Text { visible: false; text: AppData.active-document >= 0 ? AppData.documents[AppData.active-document].title : ""; font-size: 0.8125rem; }
                                        function reveal() {
                                            if self.active < 0 { return; }
                                            let left = self.active * (self.chip + 1px);
                                            if left + self.content-x < 0px {
                                                self.content-x = -left;
                                            } else if left + self.active-chip + self.content-x > self.visible-width {
                                                // Snap to a tab edge so the first visible tab is whole, not cut mid-label.
                                                let shift = max(0px, left + self.active-chip - self.visible-width);
                                                self.content-x = -Math.min(left, Math.ceil(shift / (self.chip + 1px)) * (self.chip + 1px));
                                            }
                                        }
                                        changed active-chip => { self.reveal(); }
                                        changed active => { self.reveal(); }
                                        changed chip => { self.reveal(); }
                                        changed visible-width => { self.reveal(); }
                                        min-width: 0px;
                                        min-height: 0px;
                                        content-width: max(self.visible-width, document-tabs.preferred-width);
                                        content-height: self.visible-height;
                                        vertical-scrollbar-policy: always-off;
                                        document-tabs := HorizontalLayout {
                                            spacing: 1px;
                                            alignment: start;
                                            for doc[index] in AppData.documents: DocTabChip {
                                                width: index == AppData.active-document ? document-scroll.active-chip : document-scroll.chip;
                                                title: doc.title;
                                                kind: doc.kind;
                                                selected: AppData.active-document == index;
                                                clicked => { Logic.select-document(index); }
                                                closed => { Logic.close-document(index); }
                                            }
                                        }
                                    }
                                }
                                if PanelData.maximized == "": Rectangle { height: 1px; background: Theme.edge; }

                                if AppData.activity == 4 && AppData.debugger-mode == 0: TraceDebugger { vertical-stretch: 1; }
                                if !(AppData.activity == 4 && AppData.debugger-mode == 0) && PanelData.center-visible && (PanelData.maximized == "" || PanelData.maximized == PanelData.center-active): PanelZone {
                                    geometry-changed(zone, x, y, width, height) => { root.update-drop-zone(zone, x, y, width, height); }
                                    drag-target-index <=> root.center-drop-index;
                                    zone: 1; tabs: PanelData.center-tabs; active: PanelData.center-active; active-index: PanelData.center-active-index;
                                    kind: PanelData.center-kind; title: PanelData.center-title; owner: PanelData.center-owner;
                                    document-kind: PanelData.center-document-kind; document-title: PanelData.center-document-title; document-body: PanelData.center-document-body;
                                    contract-view: PanelData.center-contract; deployment-view: PanelData.center-deployment;
                                    vertical-stretch: 1;
                                }

                                if PanelData.bottom-visible && PanelData.maximized == "": Splitter {
                                    horizontal: true; zone: 3; extent: PanelData.bottom-height;
                                    height: 6 * Theme.unit; vertical-stretch: 0;
                                }
                                if PanelData.bottom-visible && (PanelData.maximized == "" || PanelData.maximized == PanelData.bottom-active): PanelZone {
                                    preferred-height: PanelData.maximized == PanelData.bottom-active ? 0px : min(PanelData.bottom-height, PanelData.bottom-limit) * Theme.unit;
                                    vertical-stretch: PanelData.maximized == PanelData.bottom-active ? 1 : 0;
                                    geometry-changed(zone, x, y, width, height) => { root.update-drop-zone(zone, x, y, width, height); }
                                    drag-target-index <=> root.bottom-drop-index;
                                    zone: 3; tabs: PanelData.bottom-tabs; active: PanelData.bottom-active; active-index: PanelData.bottom-active-index;
                                    kind: PanelData.bottom-kind; title: PanelData.bottom-title; owner: PanelData.bottom-owner;
                                    document-kind: PanelData.bottom-document-kind; document-title: PanelData.bottom-document-title; document-body: PanelData.bottom-document-body;
                                    contract-view: PanelData.bottom-contract; deployment-view: PanelData.bottom-deployment;
                                }
                            }
                        }
                        if PanelData.right-visible && PanelData.maximized == "": Splitter {
                            zone: 2; extent: PanelData.right-width;
                            width: 6 * Theme.unit; horizontal-stretch: 0;
                        }
                        if PanelData.right-visible && (PanelData.maximized == "" || PanelData.maximized == PanelData.right-active): PanelZone {
                            preferred-width: PanelData.maximized == PanelData.right-active ? 0px : min(PanelData.right-width * Theme.unit, 480 * Theme.unit, root.side-cap * 0.58);
                            horizontal-stretch: PanelData.maximized == PanelData.right-active ? 1 : 0;
                            geometry-changed(zone, x, y, width, height) => { root.update-drop-zone(zone, x, y, width, height); }
                            drag-target-index <=> root.right-drop-index;
                            zone: 2; tabs: PanelData.right-tabs; active: PanelData.right-active; active-index: PanelData.right-active-index;
                            kind: PanelData.right-kind; title: PanelData.right-title; owner: PanelData.right-owner;
                            document-kind: PanelData.right-document-kind; document-title: PanelData.right-document-title; document-body: PanelData.right-document-body;
                            contract-view: PanelData.right-contract; deployment-view: PanelData.right-deployment;
                        }
                    }
                }

                if AppData.notice != "": Rectangle {
                    height: 4.5rem;
                    border-width: 1px;
                    border-color: Theme.edge;
                    background: Theme.inset;
                    HorizontalLayout {
                        padding: 0.5rem;
                        spacing: 0.5rem;
                        SelectableText { text: "Notice"; color: Theme.danger; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                        ScrollView {
                            min-width: 0px;
                            min-height: 0px;
                            content-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;
                            SelectableText { text: AppData.notice; color: Theme.danger; font-size: 0.75rem; wrap: word-wrap; min-width: 0px; }
                        }
                        if AppData.notice-action != "": IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/play.svg");
                            label: AppData.notice-action-label;
                            primary: true;
                            clicked => { Logic.notice-action(AppData.notice-action); }
                        }
                        CloseButton { y: (parent.height - self.height) / 2; label: "Dismiss notice"; clicked => { Logic.dismiss-notice(); } }
                    }
                }
                Rectangle {
                    height: Theme.status-height;
                    background: Theme.bar;
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: 0.875rem;
                        SelectableText { text: AppData.status-left; color: Theme.muted; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; min-width: 0px; }
                        SelectableText { text: AppData.compile-label; color: Theme.faint; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                        SelectableText { text: AppData.debugger-label; color: AppData.debugger-tint; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; min-width: 0px; }
                        SelectableText { text: AppData.block-label; color: Theme.faint; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                        SelectableText { text: "Chasm 0.1.0"; color: Theme.faint; font-size: 0.75rem; vertical-alignment: center; horizontal-stretch: 0; }
                    }
                }
            }

            if AppData.deployment-menu >= 0: TouchArea {
                clicked => { Logic.open-deployment-menu(-1); }
            }
            if AppData.deployment-menu >= 0: Rectangle {
                x: deployment-menu-x.clamp(Theme.pad, max(Theme.pad, root.width - self.width - Theme.pad));
                y: deployment-menu-y.clamp(Theme.pad, max(Theme.pad, root.height - self.height - Theme.pad));
                width: 12rem;
                height: deployment-menu-content.preferred-height;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.edge;
                border-radius: Theme.radius;
                deployment-menu-content := VerticalLayout {
                    padding: 0.25rem;
                    MenuRow { label: "Remove deployment"; clicked => { Logic.remove-deployment(AppData.deployment-menu); Logic.open-deployment-menu(-1); } }
                }
            }
            if root.hover-label != "" && root.hover-visible && AppData.menu-open < 0 && AppData.pending-workspace == "" && AppData.pending-keystore-delete == "": Rectangle {
                x: (root.hover-x < Theme.rail-width ? Theme.rail-width + 6px : root.hover-x).clamp(4px, max(4px, root.width - self.width - 4px));
                y: (root.hover-x < Theme.rail-width ? root.hover-y - 2.625rem : root.hover-y + 6px).clamp(4px, max(4px, root.height - self.height - 4px));
                width: hover-tip.preferred-width + 0.75rem;
                height: 1.5rem;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.edge;
                border-radius: Theme.radius;
                hover-tip := Text {
                    x: 0.375rem;
                    text: root.hover-label;
                    color: Theme.text;
                    font-size: 0.75rem;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            if AppData.menu-open >= 0: TouchArea {
                clicked => { Logic.close-menu(); }
            }
            if AppData.menu-open >= 0: Rectangle {
                private property <length> anchor-x: AppData.menu-open == 0 ? file-menu.absolute-position.x
                    : AppData.menu-open == 1 ? workspace-menu.absolute-position.x
                    : AppData.menu-open == 2 ? run-menu.absolute-position.x
                    : AppData.menu-open == 3 ? view-menu.absolute-position.x
                    : AppData.menu-open == 4 ? tools-menu.absolute-position.x
                    : AppData.menu-open == 6 ? panels-menu.absolute-position.x : help-menu.absolute-position.x;
                private property <length> anchor-y: file-menu.absolute-position.y + file-menu.height;
                x: anchor-x.clamp(Theme.pad, max(Theme.pad, root.width - self.width - Theme.pad));
                y: anchor-y.clamp(Theme.pad, max(Theme.pad, root.height - self.height - Theme.pad));
                width: min(18rem, root.width - 2 * Theme.pad);
                height: min(menu-content.preferred-height, root.height - 2 * Theme.pad);
                background: Theme.panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.edge;
                drop-shadow-blur: 0.75rem;
                drop-shadow-color: #00000088;
                drop-shadow-offset-y: 0.25rem;
                ScrollView {
                    min-width: 0px;
                    min-height: 0px;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    menu-content := VerticalLayout {
                        padding: 0.25rem;
                        spacing: 0px;
                        alignment: start;
                        if AppData.menu-open == 0: VerticalLayout {
                            MenuRow { label: "Open Folder…"; shortcut: "Ctrl+O"; enabled: !AppData.workspace-busy && !AppData.folder-picker-busy && !AppData.wallet-busy; clicked => { Logic.open-folder(); } }
                            MenuRow { label: "Recompile workspace"; shortcut: "Ctrl+B"; clicked => { Logic.recompile(); Logic.close-menu(); } }
                            MenuRow { label: "Compiler and libraries…"; clicked => { Logic.open-toolchain(); Logic.close-menu(); } }
                            MenuRow { label: "Quit Chasm"; clicked => { Logic.quit(); } }
                        }
                        if AppData.menu-open == 1: VerticalLayout {
                            MenuRow { label: "Deploy selected contract"; enabled: AppData.selected-contract != ""; clicked => { Logic.open-deploy(); Logic.close-menu(); } }
                            MenuRow { label: "Open storage"; enabled: AppData.selected-contract != ""; clicked => { Logic.open-storage(); Logic.close-menu(); } }
                            MenuRow { label: "Wallet"; clicked => { Logic.open-wallet(); Logic.close-menu(); } }
                            MenuRow { label: "Reload keystores"; clicked => { Logic.refresh-wallet(); Logic.close-menu(); } }
                        }
                        if AppData.menu-open == 2: VerticalLayout {
                            MenuRow { label: "Start WorkshopVault"; enabled: !AppData.debugger-live; clicked => { Logic.start-lab(); Logic.close-menu(); } }
                            MenuRow { label: "Continue"; enabled: DebugData.can-command; clicked => { Logic.debug-continue(); Logic.close-menu(); } }
                            MenuRow { label: "Read fee"; enabled: AppData.debugger-live; clicked => { Logic.read-fee(); Logic.close-menu(); } }
                            MenuRow { label: "Cancel session"; enabled: AppData.debugger-live; clicked => { Logic.debug-cancel(); Logic.close-menu(); } }
                        }
                        if AppData.menu-open == 3: VerticalLayout {
                            MenuRow { label: "Toggle sidebar"; checked: !AppData.sidebar-collapsed; clicked => { Logic.toggle-sidebar(); Logic.close-menu(); } }
                            MenuRow { label: "Narrower sidebar"; clicked => { PanelLogic.resize(0, max(120, PanelData.left-width - 20)); } }
                            MenuRow { label: "Wider sidebar"; clicked => { PanelLogic.resize(0, min(4096, PanelData.left-width + 20)); } }
                            MenuRow { label: "Reset sidebar width"; clicked => { PanelLogic.resize(0, 250); Logic.close-menu(); } }
                            MenuRow { label: "Show Logs"; clicked => { PanelLogic.dock("logs", -1); Logic.close-menu(); } }
                            MenuRow { label: "Zoom 100%"; checked: AppData.zoom-percent == 100; clicked => { Logic.select-zoom(0); } }
                            MenuRow { label: "Zoom 110%"; checked: AppData.zoom-percent == 110; clicked => { Logic.select-zoom(1); } }
                            MenuRow { label: "Zoom 125%"; checked: AppData.zoom-percent == 125; clicked => { Logic.select-zoom(2); } }
                            MenuRow { label: "Zoom 150%"; checked: AppData.zoom-percent == 150; clicked => { Logic.select-zoom(3); } }
                        }
                        if AppData.menu-open == 4: VerticalLayout {
                            MenuRow { label: "Contracts"; clicked => { Logic.open-activity(0); Logic.close-menu(); } }
                            MenuRow { label: "Explorer"; clicked => { Logic.open-activity(1); Logic.close-menu(); } }
                            MenuRow { label: "Converter"; clicked => { Logic.open-activity(2); Logic.close-menu(); } }
                            MenuRow { label: "Macros"; clicked => { Logic.open-activity(3); Logic.close-menu(); } }
                            MenuRow { label: "Trusted Foundry Build"; clicked => { Logic.open-foundry-build(); Logic.close-menu(); } }
                            MenuRow { label: "Debugger"; clicked => { Logic.open-activity(4); Logic.close-menu(); } }
                            MenuRow { label: "Investigation / Repeater"; clicked => { AppData.explorer-tab = 1; Logic.open-activity(1); InvestigationLogic.open-embedded(); Logic.close-menu(); } }
                            MenuRow { label: "Automation / AI Access"; clicked => { AutomationLogic.open(); Logic.close-menu(); } }
                        }
                        if AppData.menu-open == 5: VerticalLayout {
                            MenuRow { label: "Keyboard shortcuts"; enabled: false; }
                            MenuRow { label: "Command palette: go to anything"; shortcut: "Ctrl+K"; enabled: false; }
                            MenuRow { label: "Close tab"; shortcut: "Ctrl+W"; enabled: false; }
                            MenuRow { label: "Next / previous tab"; shortcut: "Ctrl+Tab"; enabled: false; }
                            MenuRow { label: "Send transaction"; shortcut: "Ctrl+Enter"; enabled: false; }
                            MenuRow { label: "Read / simulate"; shortcut: "Ctrl+Shift+E"; enabled: false; }
                            MenuRow { label: "Contracts .. Debugger"; shortcut: "Ctrl+1..5"; enabled: false; }
                            MenuRow { label: "Toggle sidebar"; shortcut: "Ctrl+\\"; enabled: false; }
                            MenuRow { label: "Open project"; shortcut: "Ctrl+O"; enabled: false; }
                            MenuRow { label: "Recompile"; shortcut: "Ctrl+B"; enabled: false; }
                            MenuRow { label: "Debugger: continue / back"; shortcut: "F5 / Shift+F5"; enabled: false; }
                            MenuRow { label: "Debugger: step into, over, out"; shortcut: "F11 F10 Shift+F11"; enabled: false; }
                            MenuRow { label: "Debugger: step instruction / back"; shortcut: "F7 / F8"; enabled: false; }
                            MenuRow { label: "Debugger: reverse a step (see DEBUGGER.md)"; shortcut: "Ctrl + step key"; enabled: false; }
                            MenuRow { label: "Shortcut list"; shortcut: "Ctrl+/"; enabled: false; }
                            MenuRow { label: "About Chasm desktop"; clicked => { Logic.about(); Logic.close-menu(); } }
                        }
                        if AppData.menu-open == 6: VerticalLayout {
                            MenuRow { label: "Contracts layout"; clicked => { PanelLogic.preset(0); Logic.close-menu(); } }
                            MenuRow { label: "Debugging layout"; clicked => { PanelLogic.preset(1); Logic.close-menu(); } }
                            MenuRow { label: "Investigation layout"; clicked => { PanelLogic.preset(2); Logic.close-menu(); } }
                            MenuRow { label: "Trace debugger layout (sevm)"; clicked => { PanelLogic.preset(3); Logic.close-menu(); } }
                            MenuRow { label: "Reset layout / Bring panels back"; clicked => { PanelLogic.reset(); Logic.close-menu(); } }
                            MenuRow { label: "Show Navigation"; clicked => { PanelLogic.dock("navigation", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Document"; clicked => { PanelLogic.dock("document", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Call Result"; clicked => { PanelLogic.dock("call_result", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Storage"; clicked => { PanelLogic.dock("storage", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show debugger Code"; clicked => { PanelLogic.dock("debug_code", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show debugger Inspector"; clicked => { PanelLogic.dock("debug_inspector", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show debugger Low-level"; clicked => { PanelLogic.dock("debug_inspection", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show debugger Session"; clicked => { PanelLogic.dock("debug_session", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Console"; clicked => { PanelLogic.dock("console", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Logs"; clicked => { PanelLogic.dock("logs", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Jobs"; clicked => { PanelLogic.dock("jobs", -1); Logic.close-menu(); } }
                            MenuRow { label: "Show Investigation"; clicked => { InvestigationLogic.open(); Logic.close-menu(); } }
                        }
                    }
                }
            }
        }
    }
    if root.panel-host: FocusScope {
        enabled: !PanelData.blocked;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => { if PanelData.blocked { return accept; } return reject; }
        VerticalLayout {
            min-width: 0px; min-height: 0px;
            PanelHeader { title: PanelData.pane-title; pane-id: PanelData.pane-id; floating: true; }
            if root.host-pane >= 4 && root.host-pane <= 7: DebugToolbar { }
            WorkspacePane {
                kind: root.host-pane; owner: root.host-owner;
                document-kind: PanelData.document-kind; document-title: PanelData.document-title; document-body: PanelData.document-body;
                contract-view: PanelData.contract-view; deployment-view: PanelData.deployment-view;
                vertical-stretch: 1;
            }
        }
    }
    if !root.panel-host && !AppData.workspace-ready: Rectangle {
        init => { welcome-scope.focus(); }
        background: Theme.canvas;
        forward-focus: welcome-scope;
        welcome-scope := FocusScope {
            enabled: !PanelData.blocked && !AutomationData.visible && AutomationData.approval-id == "";
            capture-key-pressed(event) => {
                if PanelData.blocked || AppData.project-opening || AppData.folder-picker-busy { return accept; }
                if event.modifiers.control && !event.modifiers.alt && (event.text == "o" || event.text == "O") {
                    Logic.open-folder();
                    return accept;
                }
                return reject;
            }
            if root.welcome-investigation: VerticalLayout {
                min-width: 0px; min-height: 0px;
                HorizontalLayout {
                    padding: Theme.pad; spacing: 0.5rem;
                    SelectableText { text: "Chasm"; color: Theme.text; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                    IconButton { icon: @image-url("icons/contracts.svg"); label: "Open Project / Folder"; enabled: !AppData.folder-picker-busy && !AppData.project-opening; clicked => { Logic.open-folder(); } }
                    IconButton { icon: @image-url("icons/stop.svg"); label: "Close Investigation"; clicked => { InvestigationLogic.close(); } }
                }
                InvestigationPanel { vertical-stretch: 1; }
            }
            if !root.welcome-investigation: VerticalLayout {
                padding: 3rem;
                spacing: 1rem;
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 1rem;
                    Image { source: @image-url("icons/logo.svg"); width: 2.5rem; height: 2.5rem; colorize: Theme.accent; accessible-role: none; }
                    SelectableText { text: "Chasm"; color: Theme.text; font-size: 2rem; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                }
                SelectableText {
                    text: AppData.project-opening ? "Opening project…" : AppData.startup-screen ? "Open a project to begin" : "Could not open project";
                    color: Theme.text; font-size: 1.25rem; font-weight: 600; wrap: word-wrap; min-width: 0px;
                }
                SelectableText {
                    text: AppData.project-opening ? "Preparing the workspace and starting local services in the background." : "Choose a Solidity or Foundry project folder. Local services start only after you open a project.";
                    color: Theme.muted; font-size: 0.875rem; wrap: word-wrap; min-width: 0px;
                }
                if AppData.workspace-path != "": SelectableText { text: AppData.workspace-path; color: Theme.faint; font-size: 0.8125rem; wrap: word-wrap; min-width: 0px; }
                if AppData.notice != "": SelectableText { text: AppData.notice; color: Theme.danger; font-size: 0.8125rem; wrap: word-wrap; min-width: 0px; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 0.75rem;
                    open-project := IconButton { icon: @image-url("icons/contracts.svg"); label: "Open Project / Folder"; primary: true; enabled: !AppData.folder-picker-busy && !AppData.project-opening; clicked => { Logic.open-folder(); } }
                    IconButton { icon: @image-url("icons/search.svg"); label: "Investigation / Open for Analysis"; enabled: !AppData.project-opening && !AppData.folder-picker-busy; clicked => { InvestigationLogic.open(); } }
                    IconButton { icon: @image-url("icons/wallet.svg"); label: "Automation / AI Access"; enabled: !AppData.project-opening && !AppData.folder-picker-busy; clicked => { AutomationLogic.open(); } }
                    IconButton { icon: @image-url("icons/stop.svg"); label: "Quit Chasm"; enabled: !AppData.project-opening && !AppData.folder-picker-busy; clicked => { Logic.quit(); } }
                }
                SelectableText { text: "Ctrl+O to open a project"; color: Theme.faint; font-size: 0.75rem; }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
    if PanelData.blocked: FocusScope {
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        capture-key-pressed(event) => { return accept; }
        background-blocker := Rectangle {
            background: root.panel-host ? #00000088 : transparent;
            TouchArea { clicked => { } scroll-event(event) => { return accept; } }
            if root.panel-host: SelectableText { text: "Finish the current action in the main window."; color: Theme.text; wrap: word-wrap; }
        }
    }
    if !root.panel-host && (AppData.workspace-busy || AppData.folder-picker-busy): Rectangle {
        background: #00000088;
        TouchArea { clicked => { } scroll-event(event) => { return accept; } }
        SelectableText { text: AppData.workspace-busy ? "Closing the current project…" : "Choose a folder in the Windows dialog."; color: Theme.text; font-size: 1rem; }
    }
    if !root.panel-host && AppData.pending-workspace != "": Confirmation {
        heading: "Open another project?";
        detail: AppData.pending-workspace;
        warning: "This closes the current Anvil and debugger session. Open tabs, constructor drafts, local deployments and chain state will reset. Saved macros remain on disk.";
        action-label: "Open project";
        cancelled => { Logic.cancel-open-folder(); }
        confirmed => { Logic.confirm-open-folder(); }
    }
    if !root.panel-host && AutomationData.visible: AutomationPanel { enabled: AutomationData.approval-id == ""; }
    if !root.panel-host && AutomationData.approval-id != "": Confirmation {
        private property <string> displayed-approval-id;
        init => { self.displayed-approval-id = AutomationData.approval-id; }
        heading: "Approve AI request?";
        detail: AutomationData.approval-detail;
        warning: "Only approve a request you recognize. This approval applies once to the displayed client, parameters and workspace. It expires after two minutes or when its context changes.";
        action-label: AutomationData.approval-action;
        cancelled => { AutomationLogic.reject(self.displayed-approval-id); }
        confirmed => { AutomationLogic.accept(self.displayed-approval-id); }
    }
    if !root.panel-host && AppData.pending-keystore-delete != "": Confirmation {
        heading: "Delete keystore?";
        detail: "\{AppData.pending-keystore-delete}\n\{AppData.pending-keystore-path}";
        warning: "This permanently deletes the local encrypted key file. Make a backup first: without another copy you may lose access to the account. The blockchain account and funds are not deleted.";
        action-label: "Delete keystore";
        cancelled => { Logic.cancel-delete-keystore(); }
        confirmed => { Logic.confirm-delete-keystore(); }
    }
    if !root.panel-host && PaletteData.open: CommandPalette { }
    if PanelData.blocked && DebugData.can-cancel: IconButton {
        x: root.width - self.width - 4px;
        y: 0px;
        icon: @image-url("icons/stop.svg"); label: "Cancel worker";
        clicked => { DebugLogic.cancel(); }
    }
}
